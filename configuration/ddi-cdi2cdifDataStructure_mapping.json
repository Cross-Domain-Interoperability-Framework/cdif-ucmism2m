{
  "$schema": "ucmis_mapping_configuration.schema.v1.1.json",
  "_comment": "DDI-CDI -> CDIF Data Structure profile UML. Source: metadataBuildingBlocks/_sources/profiles/cdifProfiles/CDIFDataStructureProfile/CDIFDataStructureProfileSchema.json. This is the most DDI-CDI-aligned profile: the JSON schema essentially exposes DDI-CDI's DataStructure / Component / RepresentedVariable / ValueDomain hierarchy. Strategy: heavy use of mappingType=map (with class rename when needed) and association renames - the same pattern as the existing DDSC example (ddi-cdi2ddsc_mapping.json). Target class names follow the JSON schema vocabulary (cdi:DataStructure, cdi:WideDataStructure, cdi:IdentifierComponent, etc.) which happen to match DDI-CDI's class names directly. The cdi:isStructuredBy hook from Distribution -> DataStructure is the key Distribution-level addition and is represented as a new association.",
  "transformation": {
    "description": "DDI-CDI to CDIF Data Structure Profile",
    "version": "0.1",
    "sourceModel": {
      "name": "DDI-CDI",
      "mainPackage": "DDICDILibrary",
      "uri": "http://ddialliance.org/Specification/DDI-CDI/1.0/XMI/"
    },
    "targetModel": {
      "acronym": "CDIFDataStructure",
      "modelTitle": "UML Model for the CDIF Data Structure Profile",
      "subTitle": "Full DDI-CDI structural complexity for tabular, long, and dimensional datasets",
      "majorVersion": "1",
      "minorVersion": "0",
      "language": "en",
      "uri": "https://w3id.org/cdif/data_structure/1.0/xmi/",
      "definition": "CDIF Data Structure profile - extends Data Description with the full DDI-CDI structural complexity. Distributions carry cdi:isStructuredBy pointing at a Data Structure node. Conforms-to: https://w3id.org/cdif/data_structure/1.0.",
      "mainPackage": "CDIFDataStructure",
      "mainPackageDefinition": "Data Structure profile: DataStructure subclasses, Components, RepresentedVariable, ValueDomain.",
      "dataTypesPackage": "CDIFDataStructure",
      "composes": [
        "ddi-cdi2cdifDataDescription_mapping.json"
      ]
    },
    "datatypeSubstitutions": {
      "TypedString": "String"
    }
  },
  "package": [
    {
      "name": "DataStructures",
      "parent": "CDIFDataStructure",
      "definition": "DataStructure umbrella class and its Dimensional/Long/Wide subclasses."
    },
    {
      "name": "Components",
      "parent": "CDIFDataStructure",
      "definition": "DataStructureComponent subclasses: Identifier, Measure, Attribute, Dimension, VariableValue, VariableDescriptor; ComponentPosition; PrimaryKey."
    },
    {
      "name": "Variables",
      "parent": "CDIFDataStructure",
      "definition": "RepresentedVariable, ReferenceVariable, DescriptorVariable plus reuse of InstanceVariable from Data Description."
    },
    {
      "name": "ValueDomains",
      "parent": "CDIFDataStructure",
      "definition": "SubstantiveValueDomain, SentinelValueDomain, DescriptorValueDomain, EnumerationDomain; Substantive/SentinelConceptualDomain, ConceptSystem, ValueAndConceptDescription."
    },
    {
      "name": "Physical",
      "parent": "CDIFDataStructure",
      "definition": "PhysicalDataSet and its subtypes (TabularTextDataSet, StructuredDataSet) - the byte-level realization a distribution is structured by."
    }
  ],
