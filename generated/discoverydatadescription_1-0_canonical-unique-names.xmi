                  <lowerValue xmi:id="DiscoveryDataDescription.AbstractMapping-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#AbstractMapping-identifier-lowerValue" xmi:type="uml:LiteralInteger">
