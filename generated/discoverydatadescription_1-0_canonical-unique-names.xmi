            <packagedElement xmi:id="DiscoveryDataDescription.AbstractMapping" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#AbstractMapping" xmi:type="uml:Class" isAbstract="true">
               <ownedComment xmi:id="DiscoveryDataDescription.AbstractMapping-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#AbstractMapping-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DiscoveryDataDescription.AbstractMapping"/>
                  <body>Abstract supertype for the cdif:hasPhysicalMapping family. Each concrete subtype maps a variable to a specific physical representation: PhysicalMapping (generic index-based), TextMapping (delimited / fixed-width text), LocatorMapping (locator string for structured data). Every concrete mapping carries a cdif:formats_InstanceVariable reference to the variable it describes.</body>
               </ownedComment>
               <name>AbstractMapping</name>
               <ownedAttribute xmi:id="DiscoveryDataDescription.AbstractMapping-identifier" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#AbstractMapping-identifier" xmi:type="uml:Property">
