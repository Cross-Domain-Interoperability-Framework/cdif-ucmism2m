                     <body>@id - URI for this variable; target of cdif:formats_InstanceVariable references from physical mappings.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DiscoveryDataDescription.InstanceVariable-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#InstanceVariable-identifier-lowerValue" xmi:type="uml:LiteralInteger">
