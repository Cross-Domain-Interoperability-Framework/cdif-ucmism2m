<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="DiscoveryDataDescription.DiscoveryDataDescription" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#DiscoveryDataDescription">
      <ownedComment xmi:id="DiscoveryDataDescription.DiscoveryDataDescription-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#DiscoveryDataDescription-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="DiscoveryDataDescription.DiscoveryDataDescription"/>
         <body>DiscoveryDataDescription is a CDIF composite profile assembled from three building-block profile modules: cdifCore (the foundational schema:Dataset shape), cdifDiscovery (measurementTechnique, variableMeasured, spatialCoverage, temporalCoverage, hasQualityMeasurement) and cdifDataDescription (variable-level physical types, primary key, statistics, physical mappings on distributions). A metadata record validating against this composite must declare conformance to https://w3id.org/cdif/core/1.0, https://w3id.org/cdif/discovery/1.0, and https://w3id.org/cdif/data_description/1.0.</body>
      </ownedComment>
      <name>DiscoveryDataDescription</name>
      <URI>https://w3id.org/cdif/data_description/1.0/composite/xmi/</URI>
      <packagedElement xmi:id="DiscoveryDataDescription.ModelIdentification" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#ModelIdentification" xmi:type="uml:DataType">
