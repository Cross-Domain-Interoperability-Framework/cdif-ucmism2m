<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CDIFManifest.CDIFManifest" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#CDIFManifest">
      <ownedComment xmi:id="CDIFManifest.CDIFManifest-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#CDIFManifest-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFManifest.CDIFManifest"/>
         <body>CDIF Archive Distribution profile module. On any Dataset whose catalog record declares conformance to https://w3id.org/cdif/manifest/1.0, schema:distribution items that are schema:DataDownloads MAY carry schema:hasPart describing the component files inside an archive. Each ArchivePart can itself carry cdif:hasPhysicalMapping and the cdi: physical-dataset co-typing (TabularTextDataSet / StructuredDataSet) when it is a tabular or structured data file.</body>
      </ownedComment>
      <name>CDIFManifest</name>
      <URI>https://w3id.org/cdif/manifest/1.0/xmi/</URI>
      <packagedElement xmi:id="CDIFManifest.ModelIdentification" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification" xmi:type="uml:DataType">
         <ownedComment xmi:id="CDIFManifest.ModelIdentification-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFManifest.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="CDIFManifest.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFManifest.ModelIdentification-prefix-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-prefix-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFManifest.ModelIdentification-prefix"/>
               <body>Namespace prefix of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFManifest.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFManifest.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>prefix</name>
            <defaultValue xmi:id="CDIFManifest.ModelIdentification-prefix-defaultValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-prefix-defaultValue" xmi:type="uml:LiteralString">
               <value>cdif</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFManifest.ModelIdentification-majorVersion" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-majorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFManifest.ModelIdentification-majorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-majorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFManifest.ModelIdentification-majorVersion"/>
               <body>Major version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFManifest.ModelIdentification-majorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-majorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFManifest.ModelIdentification-majorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-majorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>majorVersion</name>
            <defaultValue xmi:id="CDIFManifest.ModelIdentification-majorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-majorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFManifest.ModelIdentification-minorVersion" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-minorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFManifest.ModelIdentification-minorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-minorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFManifest.ModelIdentification-minorVersion"/>
               <body>Minor version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFManifest.ModelIdentification-minorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-minorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFManifest.ModelIdentification-minorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-minorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>minorVersion</name>
            <defaultValue xmi:id="CDIFManifest.ModelIdentification-minorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-minorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>0</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFManifest.ModelIdentification-title" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-title" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFManifest.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFManifest.ModelIdentification-title"/>
               <body>Title of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFManifest.ModelIdentification-title-lowerValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-title-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFManifest.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>title</name>
            <defaultValue xmi:id="CDIFManifest.ModelIdentification-title-defaultValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-title-defaultValue" xmi:type="uml:LiteralString">
               <value>UML Model for the CDIF Archive Distribution Profile</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFManifest.ModelIdentification-language" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-language" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFManifest.ModelIdentification-language-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-language-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFManifest.ModelIdentification-language"/>
               <body>Primary language of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFManifest.ModelIdentification-language-lowerValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-language-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFManifest.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>language</name>
            <defaultValue xmi:id="CDIFManifest.ModelIdentification-language-defaultValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-language-defaultValue" xmi:type="uml:LiteralString">
               <value>en</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFManifest.ModelIdentification-uri" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-uri" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFManifest.ModelIdentification-uri-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-uri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFManifest.ModelIdentification-uri"/>
               <body>Namespace URI of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFManifest.ModelIdentification-uri-lowerValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-uri-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFManifest.ModelIdentification-uri-upperValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-uri-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>uri</name>
            <defaultValue xmi:id="CDIFManifest.ModelIdentification-uri-defaultValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ModelIdentification-uri-defaultValue" xmi:type="uml:LiteralString">
               <value>https://w3id.org/cdif/manifest/1.0/xmi/</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:id="CDIFManifest.CDIFManifestPackage" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#CDIFManifest-package" xmi:type="uml:Package">
         <ownedComment xmi:id="CDIFManifest.CDIFManifestPackage-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#CDIFManifest-package-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFManifest.CDIFManifestPackage"/>
            <body>Archive distribution structure: component files inside a single download.</body>
         </ownedComment>
         <name>CDIFManifest</name>
         <packagedElement xmi:id="CDIFManifest.XsdAnyUri" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#XsdAnyUri" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFManifest.XsdAnyUri-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#XsdAnyUri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFManifest.XsdAnyUri"/>
               <body>Primitive data type "anyURI" of the XML Schema data types.

Definition from XML Schema Part 2: Datatypes Second Edition: "anyURI" represents a Uniform Resource Identifier Reference (URI). An "anyURI" value can be absolute or relative, and may have an optional fragment identifier (i.e., it may be a URI Reference). This type should be used to specify the intention that the value fulfills the role of a URI as defined by [RFC 2396], as amended by [RFC 2732]. For details see https://www.w3.org/TR/xmlschema-2/#anyURI.</body>
            </ownedComment>
            <name>XsdAnyUri</name>
         </packagedElement>
         <packagedElement xmi:id="CDIFManifest.Classes" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#Classes-package" xmi:type="uml:Package">
            <ownedComment xmi:id="CDIFManifest.Classes-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#Classes-package-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFManifest.Classes"/>
               <body>Target classes of the CDIF profile.</body>
            </ownedComment>
            <name>Classes</name>
            <packagedElement xmi:id="CDIFManifest.Dataset" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#Dataset" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFManifest.Dataset-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#Dataset-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFManifest.Dataset"/>
                  <body>Stub of schema:Dataset (full definition in CDIFCore).</body>
               </ownedComment>
               <name>Dataset</name>
               <ownedAttribute xmi:id="CDIFManifest.Dataset-identifier" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#Dataset-identifier" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFManifest.Dataset-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#Dataset-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFManifest.Dataset-identifier"/>
                     <body>@id.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFManifest.Dataset-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#Dataset-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFManifest.Dataset-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#Dataset-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFManifest.XsdAnyUri"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFManifest.Dataset-subjectOf" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#Dataset-subjectOf" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFManifest.Dataset-subjectOf-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#Dataset-subjectOf-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFManifest.Dataset-subjectOf"/>
                     <body>schema:subjectOf.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFManifest.Dataset-subjectOf-lowerValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#Dataset-subjectOf-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFManifest.Dataset-subjectOf-upperValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#Dataset-subjectOf-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>subjectOf</name>
                  <type xmi:idref="CDIFManifest.CatalogRecord"/>
                  <association xmi:idref="CDIFManifest.Dataset_subjectOf_CatalogRecord"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFManifest.CatalogRecord" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#CatalogRecord" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFManifest.CatalogRecord-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#CatalogRecord-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFManifest.CatalogRecord"/>
                  <body>Stub of CDIFCore::CatalogRecord. For manifest, dcterms:conformsTo MUST include https://w3id.org/cdif/manifest/1.0.</body>
               </ownedComment>
               <name>CatalogRecord</name>
               <ownedAttribute xmi:id="CDIFManifest.CatalogRecord-conformsTo" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#CatalogRecord-conformsTo" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFManifest.CatalogRecord-conformsTo-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#CatalogRecord-conformsTo-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFManifest.CatalogRecord-conformsTo"/>
                     <body>dcterms:conformsTo.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFManifest.CatalogRecord-conformsTo-lowerValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#CatalogRecord-conformsTo-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFManifest.CatalogRecord-conformsTo-upperValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#CatalogRecord-conformsTo-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>conformsTo</name>
                  <type xmi:idref="CDIFManifest.XsdAnyUri"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFManifest.DataDownload" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#DataDownload" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFManifest.DataDownload-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#DataDownload-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFManifest.DataDownload"/>
                  <body>Stub of CDIFCore::DataDownload. Carries schema:hasPart when the file is an archive.</body>
               </ownedComment>
               <name>DataDownload</name>
               <ownedAttribute xmi:id="CDIFManifest.DataDownload-encodingFormat" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#DataDownload-encodingFormat" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFManifest.DataDownload-encodingFormat-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#DataDownload-encodingFormat-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFManifest.DataDownload-encodingFormat"/>
                     <body>schema:encodingFormat - including 'application/zip' triggers the hasPart requirement.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFManifest.DataDownload-encodingFormat-lowerValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#DataDownload-encodingFormat-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFManifest.DataDownload-encodingFormat-upperValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#DataDownload-encodingFormat-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>encodingFormat</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFManifest.DataDownload-hasPart" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#DataDownload-hasPart" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFManifest.DataDownload-hasPart-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#DataDownload-hasPart-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFManifest.DataDownload-hasPart"/>
                     <body>schema:hasPart - component files inside this archive.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFManifest.DataDownload-hasPart-lowerValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#DataDownload-hasPart-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFManifest.DataDownload-hasPart-upperValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#DataDownload-hasPart-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>hasPart</name>
                  <type xmi:idref="CDIFManifest.ArchivePart"/>
                  <association xmi:idref="CDIFManifest.DataDownload_hasPart_ArchivePart"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFManifest.ArchivePart" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ArchivePart" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFManifest.ArchivePart-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ArchivePart-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFManifest.ArchivePart"/>
                  <body>A component file within an archive distribution. Typed schema:MediaObject. May itself carry cdif:hasPhysicalMapping and the cdi: physical-dataset co-typing when the part is a tabular or structured data file.</body>
               </ownedComment>
               <name>ArchivePart</name>
               <ownedAttribute xmi:id="CDIFManifest.ArchivePart-identifier" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ArchivePart-identifier" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFManifest.ArchivePart-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ArchivePart-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFManifest.ArchivePart-identifier"/>
                     <body>@id - typically a hash-anchor.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFManifest.ArchivePart-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ArchivePart-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFManifest.ArchivePart-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ArchivePart-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFManifest.XsdAnyUri"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFManifest.ArchivePart-name" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ArchivePart-name" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFManifest.ArchivePart-name-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ArchivePart-name-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFManifest.ArchivePart-name"/>
                     <body>schema:name - filename.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFManifest.ArchivePart-name-lowerValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ArchivePart-name-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFManifest.ArchivePart-name-upperValue" xmi:uuid="https://w3id.org/cdif/manifest/1.0/xmi/#ArchivePart-name-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>name</name>
