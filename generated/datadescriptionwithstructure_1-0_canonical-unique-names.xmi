               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.LanguageString-isTranslated-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-isTranslated-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.LanguageString-isTranslated-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-isTranslated-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>isTranslated</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Boolean"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.LanguageString-language" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-language" xmi:type="uml:Property">
