            </ownedComment>
            <name>NonDdiIdentifier</name>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.NonDdiIdentifier-managingAgency" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#NonDdiIdentifier-managingAgency" xmi:type="uml:Property">
