         <packagedElement xmi:id="DataDescriptionWithStructure.AccessInformation" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AccessInformation" xmi:type="uml:DataType">
            <ownedComment xmi:id="DataDescriptionWithStructure.AccessInformation-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AccessInformation-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="DataDescriptionWithStructure.AccessInformation"/>
               <body>A set of information important for understanding access conditions. Examples include license, embargo details.</body>
            </ownedComment>
            <name>AccessInformation</name>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.AccessInformation-copyright" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AccessInformation-copyright" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.AccessInformation-copyright-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AccessInformation-copyright-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.AccessInformation-copyright"/>
