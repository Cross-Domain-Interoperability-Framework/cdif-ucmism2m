                     <annotatedElement xmi:idref="DataDescriptionWithStructure.PhysicalDataSet-identifier"/>
                     <body>Identifier for objects requiring short- or long-lasting referencing and management.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.PhysicalDataSet-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalDataSet-identifier-lowerValue" xmi:type="uml:LiteralInteger">
