               <upperValue xmi:id="DataDescriptionWithStructure.LanguageString-translationSourceLanguage-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-translationSourceLanguage-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                  <value>*</value>
