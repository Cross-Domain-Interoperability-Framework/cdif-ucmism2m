               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.CatalogDetails-publisher-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogDetails-publisher-lowerValue" xmi:type="uml:LiteralInteger">
