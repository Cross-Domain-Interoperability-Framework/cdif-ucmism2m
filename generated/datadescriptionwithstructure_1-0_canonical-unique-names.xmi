            <ownedLiteral xmi:id="DataDescriptionWithStructure.CategoryRelationCode-Interval" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CategoryRelationCode-Interval" xmi:type="uml:EnumerationLiteral">
