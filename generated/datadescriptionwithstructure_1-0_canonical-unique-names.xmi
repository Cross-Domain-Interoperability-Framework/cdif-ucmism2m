                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.ControlledVocabularyEntry-name-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-name-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>name</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.ControlledVocabularyEntry-valueForOther" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-valueForOther" xmi:type="uml:Property">
