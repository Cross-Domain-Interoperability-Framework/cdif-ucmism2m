                     <annotatedElement xmi:idref="DataDescriptionWithStructure.DataDownload-hasPhysicalMapping"/>
                     <body>cdif:hasPhysicalMapping - per-field physical mappings linking variables to their on-disk representation. Each item is one of PhysicalMapping / TextMapping / LocatorMapping.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.DataDownload-hasPhysicalMapping-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-hasPhysicalMapping-lowerValue" xmi:type="uml:LiteralInteger">
