                  </lowerValue>
                  <upperValue xmi:id="DataDescriptionWithStructure.PhysicalMapping-physicalDataType-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalMapping-physicalDataType-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
