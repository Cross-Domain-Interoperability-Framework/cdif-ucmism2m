               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.NonDdiIdentifier-version-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#NonDdiIdentifier-version-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.NonDdiIdentifier-version-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#NonDdiIdentifier-version-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
