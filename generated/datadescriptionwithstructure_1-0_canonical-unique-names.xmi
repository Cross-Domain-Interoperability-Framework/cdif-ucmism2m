                     <annotatedElement xmi:idref="DataDescriptionWithStructure.AbstractMapping-formats"/>
                     <body>cdif:formats_InstanceVariable - the InstanceVariable this mapping describes (by @id reference).</body>
                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.AbstractMapping-formats-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AbstractMapping-formats-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="DataDescriptionWithStructure.AbstractMapping-formats-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AbstractMapping-formats-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>formats</name>
                  <type xmi:idref="DataDescriptionWithStructure.InstanceVariable"/>
                  <association xmi:idref="DataDescriptionWithStructure.LocatorMapping_formats_InstanceVariable"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="DataDescriptionWithStructure.PhysicalMapping" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalMapping" xmi:type="uml:Class">
