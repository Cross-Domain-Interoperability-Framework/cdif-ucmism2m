               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.LanguageString-structureUsed-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-structureUsed-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.LanguageString-structureUsed-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-structureUsed-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>structureUsed</name>
               <type xmi:idref="DataDescriptionWithStructure.ControlledVocabularyEntry"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.LanguageString-translationDate" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-translationDate" xmi:type="uml:Property">
