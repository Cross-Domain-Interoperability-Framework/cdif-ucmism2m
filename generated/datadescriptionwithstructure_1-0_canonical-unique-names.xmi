                  <upperValue xmi:id="DataDescriptionWithStructure.PhysicalMapping-format-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalMapping-format-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>format</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="DataDescriptionWithStructure.PhysicalMapping-physicalDataType" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalMapping-physicalDataType" xmi:type="uml:Property">
                  <ownedComment xmi:id="DataDescriptionWithStructure.PhysicalMapping-physicalDataType-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalMapping-physicalDataType-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="DataDescriptionWithStructure.PhysicalMapping-physicalDataType"/>
                     <body>cdif:physicalDataType - physical representation type for this column's bytes.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.PhysicalMapping-physicalDataType-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalMapping-physicalDataType-lowerValue" xmi:type="uml:LiteralInteger">
