                  <upperValue xmi:id="DataDescriptionWithStructure.PhysicalMapping-index-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalMapping-index-upperValue" xmi:type="uml:LiteralInteger">
