   <uml:Model xmi:id="DataDescriptionWithStructure.DataDescriptionWithStructure" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDescriptionWithStructure">
      <ownedComment xmi:id="DataDescriptionWithStructure.DataDescriptionWithStructure-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDescriptionWithStructure-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="DataDescriptionWithStructure.DataDescriptionWithStructure"/>
         <body>CDIF Data Structure profile - extends Data Description with the full DDI-CDI structural complexity. Distributions carry cdi:isStructuredBy pointing at a Data Structure node. Conforms-to: https://w3id.org/cdif/data_structure/1.0.</body>
      </ownedComment>
      <name>DataDescriptionWithStructure</name>
      <URI>https://w3id.org/cdif/data_structure/1.0/xmi/</URI>
      <packagedElement xmi:id="DataDescriptionWithStructure.ModelIdentification" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification" xmi:type="uml:DataType">
