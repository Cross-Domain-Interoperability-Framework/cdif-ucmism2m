                  <annotatedElement xmi:idref="DataDescriptionWithStructure.CatalogDetails-relatedResource"/>
                  <body>Provide the identifier, managing agency, and type of resource related to this object. Use to specify related resources similar to Dublin Core isPartOf and hasPart to indicate collection/series membership for objects where there is an identifiable record. If not an identified object use the relationship to ExternalMaterial using a type that indicates a series description.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.CatalogDetails-relatedResource-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogDetails-relatedResource-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.CatalogDetails-relatedResource-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogDetails-relatedResource-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
