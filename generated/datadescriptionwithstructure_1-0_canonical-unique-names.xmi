               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.LanguageString-content-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-content-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.LanguageString-content-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-content-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>content</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.LanguageString-isTranslatable" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-isTranslatable" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.LanguageString-isTranslatable-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-isTranslatable-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.LanguageString-isTranslatable"/>
                  <body>Indicates whether content is translatable (True) or not (False). An example of something that is not translatable would be a MNEMONIC of an object or a number.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.LanguageString-isTranslatable-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-isTranslatable-lowerValue" xmi:type="uml:LiteralInteger">
