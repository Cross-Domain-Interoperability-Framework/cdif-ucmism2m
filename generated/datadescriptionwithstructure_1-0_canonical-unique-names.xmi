               <lowerValue xmi:id="DataDescriptionWithStructure.Identifier-nonDdiIdentifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-nonDdiIdentifier-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.Identifier-nonDdiIdentifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-nonDdiIdentifier-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
