            <ownedAttribute xmi:id="DataDescriptionWithStructure.LanguageString-scope" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-scope" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.LanguageString-scope-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-scope-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.LanguageString-scope"/>
                  <body>Supports specification of scope for the contained content. Use with the language specification to filter application of content.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.LanguageString-scope-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-scope-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.LanguageString-scope-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-scope-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>scope</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
