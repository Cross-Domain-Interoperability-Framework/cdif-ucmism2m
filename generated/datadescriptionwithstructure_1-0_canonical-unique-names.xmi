               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.ObjectName-context-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ObjectName-context-upperValue" xmi:type="uml:LiteralInteger">
