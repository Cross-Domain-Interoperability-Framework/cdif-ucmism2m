               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.LanguageString-translationDate-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-translationDate-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
