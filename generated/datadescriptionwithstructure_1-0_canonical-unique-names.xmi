                  </lowerValue>
                  <upperValue xmi:id="DataDescriptionWithStructure.DataDownload-hasPhysicalMapping-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-hasPhysicalMapping-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
