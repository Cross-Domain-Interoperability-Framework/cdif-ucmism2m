                  <value>*</value>
               </upperValue>
               <name>entryValue</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.ControlledVocabularyEntry-name" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-name" xmi:type="uml:Property">
