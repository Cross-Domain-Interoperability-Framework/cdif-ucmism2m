               <lowerValue xmi:id="DataDescriptionWithStructure.AccessInformation-embargo-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AccessInformation-embargo-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.AccessInformation-embargo-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AccessInformation-embargo-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                  <value>*</value>
               </upperValue>
