                  </lowerValue>
                  <upperValue xmi:id="DataDescriptionWithStructure.PhysicalDataSet-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalDataSet-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="DataDescriptionWithStructure.Identifier"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="DataDescriptionWithStructure.PhysicalDataSet-name" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalDataSet-name" xmi:type="uml:Property">
                  <ownedComment xmi:id="DataDescriptionWithStructure.PhysicalDataSet-name-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalDataSet-name-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="DataDescriptionWithStructure.PhysicalDataSet-name"/>
                     <body>Human understandable name (linguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.PhysicalDataSet-name-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalDataSet-name-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="DataDescriptionWithStructure.PhysicalDataSet-name-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalDataSet-name-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>name</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
