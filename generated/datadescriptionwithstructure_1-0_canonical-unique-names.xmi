      <packagedElement xmi:id="DataDescriptionWithStructure.DataDescriptionWithStructurePackage" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDescriptionWithStructure-package" xmi:type="uml:Package">
