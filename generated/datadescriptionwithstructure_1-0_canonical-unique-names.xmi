                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.DataDownload-fingerprint-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-fingerprint-lowerValue" xmi:type="uml:LiteralInteger">
