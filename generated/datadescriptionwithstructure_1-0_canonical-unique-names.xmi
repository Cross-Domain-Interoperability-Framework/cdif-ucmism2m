               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.LabelForDisplay-locationVariant-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LabelForDisplay-locationVariant-lowerValue" xmi:type="uml:LiteralInteger">
