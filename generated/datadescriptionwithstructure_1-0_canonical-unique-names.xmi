                  <lowerValue xmi:id="DataDescriptionWithStructure.ActionResult-characterSet-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ActionResult-characterSet-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="DataDescriptionWithStructure.ActionResult-characterSet-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ActionResult-characterSet-upperValue" xmi:type="uml:LiteralInteger">
