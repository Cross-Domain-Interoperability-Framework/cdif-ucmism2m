               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.DateRange-endDate-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DateRange-endDate-lowerValue" xmi:type="uml:LiteralInteger">
