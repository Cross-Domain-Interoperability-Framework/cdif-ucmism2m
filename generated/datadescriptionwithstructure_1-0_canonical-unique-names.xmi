               <annotatedElement xmi:idref="DataDescriptionWithStructure.CategoryRelationCode"/>
               <body>Indicates the type of relationship, nominal, ordinal, interval, ratio, or continuous. Use where appropriate for the representation type.</body>
            </ownedComment>
            <name>CategoryRelationCode</name>
            <ownedLiteral xmi:id="DataDescriptionWithStructure.CategoryRelationCode-Continuous" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CategoryRelationCode-Continuous" xmi:type="uml:EnumerationLiteral">
