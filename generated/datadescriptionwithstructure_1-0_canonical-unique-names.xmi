               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.DataFingerprint-value-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataFingerprint-value-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.DataFingerprint-value-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataFingerprint-value-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
