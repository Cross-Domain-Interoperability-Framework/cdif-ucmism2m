                     <annotatedElement xmi:idref="DataDescriptionWithStructure.DataDownload-isStructuredBy"/>
                     <body>cdi:isStructuredBy - the DataStructure describing this distribution's physical layout.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.DataDownload-isStructuredBy-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="DataDescriptionWithStructure.DataDownload-isStructuredBy-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>isStructuredBy</name>
                  <type xmi:idref="DataDescriptionWithStructure.DataStructure"/>
                  <association xmi:idref="DataDescriptionWithStructure.DataDownload_isStructuredBy_DataStructure"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="DataDescriptionWithStructure.DataDownload-hasPhysicalMapping" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-hasPhysicalMapping" xmi:type="uml:Property" aggregation="composite">
