         <name>DataDescriptionWithStructure</name>
         <packagedElement xmi:id="DataDescriptionWithStructure.Identifier" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier" xmi:type="uml:DataType">
            <ownedComment xmi:id="DataDescriptionWithStructure.Identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="DataDescriptionWithStructure.Identifier"/>
               <body>Identifier for objects requiring short- or long-lasting referencing and management.</body>
            </ownedComment>
            <name>Identifier</name>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.Identifier-ddiIdentifier" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-ddiIdentifier" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.Identifier-ddiIdentifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-ddiIdentifier-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.Identifier-ddiIdentifier"/>
                  <body>A globally unique identifier. The values of the three attributes can be used to create a DDI URN.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.Identifier-ddiIdentifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-ddiIdentifier-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.Identifier-ddiIdentifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-ddiIdentifier-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>ddiIdentifier</name>
               <type xmi:idref="DataDescriptionWithStructure.InternationalRegistrationDataIdentifier"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.Identifier-isDdiIdentifierPersistent" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-isDdiIdentifierPersistent" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.Identifier-isDdiIdentifierPersistent-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-isDdiIdentifierPersistent-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.Identifier-isDdiIdentifierPersistent"/>
                  <body>Default value is False indicating that the content of the current version may change (may be in development mode). Set to True when the content of this version will no longer change.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.Identifier-isDdiIdentifierPersistent-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-isDdiIdentifierPersistent-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.Identifier-isDdiIdentifierPersistent-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-isDdiIdentifierPersistent-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>isDdiIdentifierPersistent</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Boolean"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.Identifier-isDdiIdentifierUniversallyUnique" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-isDdiIdentifierUniversallyUnique" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.Identifier-isDdiIdentifierUniversallyUnique-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-isDdiIdentifierUniversallyUnique-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.Identifier-isDdiIdentifierUniversallyUnique"/>
                  <body>Default value is False. If the id of the object was created as a Universally Unique ID (UUID) set to True.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.Identifier-isDdiIdentifierUniversallyUnique-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-isDdiIdentifierUniversallyUnique-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.Identifier-isDdiIdentifierUniversallyUnique-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-isDdiIdentifierUniversallyUnique-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>isDdiIdentifierUniversallyUnique</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Boolean"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.Identifier-nonDdiIdentifier" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-nonDdiIdentifier" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.Identifier-nonDdiIdentifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-nonDdiIdentifier-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.Identifier-nonDdiIdentifier"/>
