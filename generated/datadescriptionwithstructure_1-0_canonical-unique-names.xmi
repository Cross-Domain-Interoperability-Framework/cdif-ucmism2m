                  <annotatedElement xmi:idref="DataDescriptionWithStructure.DateRange-startDate"/>
                  <body>The date (time) designating the beginning of the period or range.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.DateRange-startDate-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DateRange-startDate-lowerValue" xmi:type="uml:LiteralInteger">
