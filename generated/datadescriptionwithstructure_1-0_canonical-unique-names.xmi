                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.PhysicalDataSet-overview-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalDataSet-overview-lowerValue" xmi:type="uml:LiteralInteger">
