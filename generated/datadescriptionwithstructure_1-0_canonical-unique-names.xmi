                     <annotatedElement xmi:idref="DataDescriptionWithStructure.WebAPI-potentialActionResult"/>
                     <body>schema:potentialAction.schema:result - the response object of the WebAPI's main action. Carries cdif:hasPhysicalMapping + cdi:characterSet at this profile level.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.WebAPI-potentialActionResult-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#WebAPI-potentialActionResult-lowerValue" xmi:type="uml:LiteralInteger">
