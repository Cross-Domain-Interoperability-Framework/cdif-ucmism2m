               <ownedComment xmi:id="DataDescriptionWithStructure.DataFingerprint-value-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataFingerprint-value-ownedComment" xmi:type="uml:Comment">
