               </ownedAttribute>
               <ownedAttribute xmi:id="DataDescriptionWithStructure.ActionResult-isStructuredBy" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ActionResult-isStructuredBy" xmi:type="uml:Property">
                  <ownedComment xmi:id="DataDescriptionWithStructure.ActionResult-isStructuredBy-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ActionResult-isStructuredBy-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="DataDescriptionWithStructure.ActionResult-isStructuredBy"/>
                     <body>cdi:isStructuredBy - the DataStructure describing the physical layout of this Action result representation.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.ActionResult-isStructuredBy-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ActionResult-isStructuredBy-lowerValue" xmi:type="uml:LiteralInteger">
