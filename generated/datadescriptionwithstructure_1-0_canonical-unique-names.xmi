                  <annotatedElement xmi:idref="DataDescriptionWithStructure.InternationalString-languageSpecificString"/>
                  <body>A non-formatted string of text with an attribute that designates the language of the text. Repeat this object to express the same content in another language.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.InternationalString-languageSpecificString-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InternationalString-languageSpecificString-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.InternationalString-languageSpecificString-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InternationalString-languageSpecificString-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                  <value>*</value>
               </upperValue>
               <name>languageSpecificString</name>
               <type xmi:idref="DataDescriptionWithStructure.LanguageString"/>
            </ownedAttribute>
         </packagedElement>
