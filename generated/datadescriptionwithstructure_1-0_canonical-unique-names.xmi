         <packagedElement xmi:id="DataDescriptionWithStructure.DateRange" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DateRange" xmi:type="uml:DataType">
            <ownedComment xmi:id="DataDescriptionWithStructure.DateRange-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DateRange-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="DataDescriptionWithStructure.DateRange"/>
               <body>Expresses a date/time range using a start date and end date (both with the structure of Date and supporting the use of ISO and non-ISO date structures). Use in all locations where a range of dates is required, i.e. validFor, embargoPeriod, collectionPeriod, etc.</body>
            </ownedComment>
            <name>DateRange</name>
