                  <body>The term attributed to the parent class, for example the role of a contributor.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.PairedControlledVocabularyEntry-term-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PairedControlledVocabularyEntry-term-lowerValue" xmi:type="uml:LiteralInteger">
