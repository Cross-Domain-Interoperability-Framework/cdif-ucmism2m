                  </lowerValue>
                  <upperValue xmi:id="DataDescriptionWithStructure.DataDownload-characterSet-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-characterSet-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>characterSet</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="DataDescriptionWithStructure.DataDownload-fingerprint" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-fingerprint" xmi:type="uml:Property">
                  <ownedComment xmi:id="DataDescriptionWithStructure.DataDownload-fingerprint-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-fingerprint-ownedComment" xmi:type="uml:Comment">
