                  <value>1</value>
               </upperValue>
               <name>isTranslatable</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Boolean"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.LanguageString-isTranslated" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-isTranslated" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.LanguageString-isTranslated-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-isTranslated-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.LanguageString-isTranslated"/>
