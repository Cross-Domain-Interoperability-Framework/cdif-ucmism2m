                  <annotatedElement xmi:idref="DataDescriptionWithStructure.ObjectName-name"/>
                  <body>The expressed name of the object.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.ObjectName-name-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ObjectName-name-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.ObjectName-name-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ObjectName-name-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
