            <ownedAttribute xmi:id="DataDescriptionWithStructure.NonDdiIdentifier-type" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#NonDdiIdentifier-type" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.NonDdiIdentifier-type-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#NonDdiIdentifier-type-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.NonDdiIdentifier-type"/>
                  <body>The scheme of identifier, as distinct from a URI or a DDI-conforming identifier.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.NonDdiIdentifier-type-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#NonDdiIdentifier-type-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.NonDdiIdentifier-type-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#NonDdiIdentifier-type-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>type</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.NonDdiIdentifier-value" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#NonDdiIdentifier-value" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.NonDdiIdentifier-value-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#NonDdiIdentifier-value-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.NonDdiIdentifier-value"/>
                  <body>The identifier, structured according to the specified type.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.NonDdiIdentifier-value-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#NonDdiIdentifier-value-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.NonDdiIdentifier-value-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#NonDdiIdentifier-value-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>value</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.NonDdiIdentifier-version" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#NonDdiIdentifier-version" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.NonDdiIdentifier-version-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#NonDdiIdentifier-version-ownedComment" xmi:type="uml:Comment">
