                     <annotatedElement xmi:idref="DataDescriptionWithStructure.DataDownload-characterSet"/>
                     <body>cdi:characterSet - character encoding of a text-based distribution (e.g. UTF-8). Required by CDIF Data Description for text distributions.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.DataDownload-characterSet-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-characterSet-lowerValue" xmi:type="uml:LiteralInteger">
