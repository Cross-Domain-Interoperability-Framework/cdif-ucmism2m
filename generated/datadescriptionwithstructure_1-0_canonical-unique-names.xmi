               <name>Nominal</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="DataDescriptionWithStructure.CategoryRelationCode-Ordinal" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CategoryRelationCode-Ordinal" xmi:type="uml:EnumerationLiteral">
               <name>Ordinal</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="DataDescriptionWithStructure.CategoryRelationCode-Ratio" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CategoryRelationCode-Ratio" xmi:type="uml:EnumerationLiteral">
