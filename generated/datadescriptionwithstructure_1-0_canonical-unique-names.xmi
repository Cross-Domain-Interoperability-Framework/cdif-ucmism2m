            <ownedAttribute xmi:id="DataDescriptionWithStructure.LanguageString-translationSourceLanguage" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-translationSourceLanguage" xmi:type="uml:Property">
