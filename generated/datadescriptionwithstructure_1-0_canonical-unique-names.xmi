            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.Identifier-uri" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-uri" xmi:type="uml:Property">
