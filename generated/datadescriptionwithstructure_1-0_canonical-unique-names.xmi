                  <annotatedElement xmi:idref="DataDescriptionWithStructure.PhysicalMapping"/>
                  <body>Generic per-field physical mapping. Carries column index, format, physical data type, null sequence, etc., for a variable's representation in a file.</body>
               </ownedComment>
               <name>PhysicalMapping</name>
               <generalization xmi:id="DataDescriptionWithStructure.PhysicalMapping-generalization-AbstractMapping" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalMapping-generalization-AbstractMapping" xmi:type="uml:Generalization">
                  <general xmi:idref="DataDescriptionWithStructure.AbstractMapping"/>
               </generalization>
               <ownedAttribute xmi:id="DataDescriptionWithStructure.PhysicalMapping-index" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalMapping-index" xmi:type="uml:Property">
