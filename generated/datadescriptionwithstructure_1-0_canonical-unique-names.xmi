            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.DataFingerprint-algorithmVersion" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataFingerprint-algorithmVersion" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.DataFingerprint-algorithmVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataFingerprint-algorithmVersion-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.DataFingerprint-algorithmVersion"/>
                  <body>The version of the algorithm used to compute the value of the fingerprint.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.DataFingerprint-algorithmVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataFingerprint-algorithmVersion-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.DataFingerprint-algorithmVersion-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataFingerprint-algorithmVersion-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>algorithmVersion</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.DataFingerprint-typeOfFingerprint" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataFingerprint-typeOfFingerprint" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.DataFingerprint-typeOfFingerprint-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataFingerprint-typeOfFingerprint-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.DataFingerprint-typeOfFingerprint"/>
                  <body>The type of fingerprint, which may be computed on the physical data set (storage format specific) or data set (format neutral).</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.DataFingerprint-typeOfFingerprint-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataFingerprint-typeOfFingerprint-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.DataFingerprint-typeOfFingerprint-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataFingerprint-typeOfFingerprint-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>typeOfFingerprint</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
