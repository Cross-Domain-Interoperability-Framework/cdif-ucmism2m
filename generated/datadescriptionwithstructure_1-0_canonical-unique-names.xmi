         <packagedElement xmi:id="DataDescriptionWithStructure.ObjectName" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ObjectName" xmi:type="uml:DataType">
            <ownedComment xmi:id="DataDescriptionWithStructure.ObjectName-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ObjectName-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="DataDescriptionWithStructure.ObjectName"/>
               <body>A standard means of expressing a name for a class object. A linguistic signifier. Human understandable name (word, phrase, or mnemonic) that reflects the ISO/IEC 11179-5 naming principles.</body>
            </ownedComment>
            <name>ObjectName</name>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.ObjectName-context" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ObjectName-context" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.ObjectName-context-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ObjectName-context-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.ObjectName-context"/>
                  <body>A name may be specific to a particular context, i.e., a type of software, or a section of a registry. Identify the context related to the specified name.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.ObjectName-context-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ObjectName-context-lowerValue" xmi:type="uml:LiteralInteger">
