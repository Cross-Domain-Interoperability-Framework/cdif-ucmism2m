               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.AccessInformation-copyright-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AccessInformation-copyright-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                  <value>*</value>
               </upperValue>
               <name>copyright</name>
               <type xmi:idref="DataDescriptionWithStructure.InternationalString"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.AccessInformation-embargo" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AccessInformation-embargo" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.AccessInformation-embargo-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AccessInformation-embargo-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.AccessInformation-embargo"/>
