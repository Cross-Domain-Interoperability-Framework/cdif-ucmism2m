               <upperValue xmi:id="DataDescriptionWithStructure.CatalogDetails-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogDetails-identifier-upperValue" xmi:type="uml:LiteralInteger">
