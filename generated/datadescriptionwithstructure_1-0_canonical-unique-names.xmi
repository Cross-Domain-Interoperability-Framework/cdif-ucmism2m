                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="DataDescriptionWithStructure.DataDownload-characterSet-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-characterSet-upperValue" xmi:type="uml:LiteralInteger">
