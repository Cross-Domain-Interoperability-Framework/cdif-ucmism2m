            <ownedAttribute xmi:id="DataDescriptionWithStructure.Identifier-versionDate" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-versionDate" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.Identifier-versionDate-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-versionDate-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.Identifier-versionDate"/>
                  <body>Date and time the object was changed expressed in standard ISO formats.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.Identifier-versionDate-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-versionDate-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.Identifier-versionDate-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-versionDate-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>versionDate</name>
               <type xmi:idref="DataDescriptionWithStructure.XsdDate"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.Identifier-versionRationale" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-versionRationale" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.Identifier-versionRationale-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-versionRationale-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.Identifier-versionRationale"/>
                  <body>Reason for making a new version of the object.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.Identifier-versionRationale-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-versionRationale-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.Identifier-versionRationale-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-versionRationale-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>versionRationale</name>
               <type xmi:idref="DataDescriptionWithStructure.RationaleDefinition"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.Identifier-versionResponsibility" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-versionResponsibility" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.Identifier-versionResponsibility-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-versionResponsibility-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.Identifier-versionResponsibility"/>
                  <body>Contributor who has the ownership and responsibility for the current version.</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.Identifier-versionResponsibility-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-versionResponsibility-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.Identifier-versionResponsibility-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-versionResponsibility-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>versionResponsibility</name>
               <type xmi:idref="DataDescriptionWithStructure.AgentInRole"/>
