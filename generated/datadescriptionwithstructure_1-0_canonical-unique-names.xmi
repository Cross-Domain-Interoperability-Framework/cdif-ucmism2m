                  <upperValue xmi:id="DataDescriptionWithStructure.DataDownload-fingerprint-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-fingerprint-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>fingerprint</name>
                  <type xmi:idref="DataDescriptionWithStructure.DataFingerprint"/>
               </ownedAttribute>
