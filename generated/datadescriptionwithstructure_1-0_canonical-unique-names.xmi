                     <annotatedElement xmi:idref="DataDescriptionWithStructure.PhysicalDataSet-fileSize"/>
                     <body>File size expressed as a real number.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.PhysicalDataSet-fileSize-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalDataSet-fileSize-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="DataDescriptionWithStructure.PhysicalDataSet-fileSize-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalDataSet-fileSize-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
