               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.DateRange-endDate-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DateRange-endDate-upperValue" xmi:type="uml:LiteralInteger">
