               </ownedAttribute>
               <ownedAttribute xmi:id="DataDescriptionWithStructure.DataDownload-isStructuredBy" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy" xmi:type="uml:Property">
