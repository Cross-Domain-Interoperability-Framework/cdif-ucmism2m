               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.Identifier-uri-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-uri-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.Identifier-uri-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Identifier-uri-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>uri</name>
