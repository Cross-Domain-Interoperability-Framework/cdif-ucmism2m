         <packagedElement xmi:id="DataDescriptionWithStructure.PairedControlledVocabularyEntry" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PairedControlledVocabularyEntry" xmi:type="uml:DataType">
            <ownedComment xmi:id="DataDescriptionWithStructure.PairedControlledVocabularyEntry-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PairedControlledVocabularyEntry-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="DataDescriptionWithStructure.PairedControlledVocabularyEntry"/>
               <body>A tightly bound pair of items from an external controlled vocabulary. The extent property describes the extent to which the parent term applies for the specific case.</body>
            </ownedComment>
            <name>PairedControlledVocabularyEntry</name>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.PairedControlledVocabularyEntry-extent" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PairedControlledVocabularyEntry-extent" xmi:type="uml:Property">
               <ownedComment xmi:id="DataDescriptionWithStructure.PairedControlledVocabularyEntry-extent-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PairedControlledVocabularyEntry-extent-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DataDescriptionWithStructure.PairedControlledVocabularyEntry-extent"/>
                  <body>Describes the extent to which the parent term applies for the specific case using an external controlled vocabulary. When associated with a role from the CASRAI Contributor Roles Taxonomy an appropriate vocabulary should be specified as either "lead", "equal", or "supporting".</body>
               </ownedComment>
               <lowerValue xmi:id="DataDescriptionWithStructure.PairedControlledVocabularyEntry-extent-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PairedControlledVocabularyEntry-extent-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="DataDescriptionWithStructure.PairedControlledVocabularyEntry-extent-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PairedControlledVocabularyEntry-extent-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
