               <name>locationVariant</name>
               <type xmi:idref="DataDescriptionWithStructure.ControlledVocabularyEntry"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="DataDescriptionWithStructure.LabelForDisplay-maxLength" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LabelForDisplay-maxLength" xmi:type="uml:Property">
