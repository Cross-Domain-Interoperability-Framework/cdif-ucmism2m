                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.PhysicalMapping-format-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalMapping-format-lowerValue" xmi:type="uml:LiteralInteger">
