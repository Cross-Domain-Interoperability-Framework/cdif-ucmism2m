                  </ownedComment>
                  <lowerValue xmi:id="DataDescriptionWithStructure.PhysicalMapping-index-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PhysicalMapping-index-lowerValue" xmi:type="uml:LiteralInteger">
