            <defaultValue xmi:id="CDIFProvenance.ModelIdentification-language-defaultValue" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#ModelIdentification-language-defaultValue" xmi:type="uml:LiteralString">
