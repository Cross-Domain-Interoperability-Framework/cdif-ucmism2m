<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CDIFProvenance.CDIFProvenance" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#CDIFProvenance">
      <ownedComment xmi:id="CDIFProvenance.CDIFProvenance-ownedComment" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#CDIFProvenance-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFProvenance.CDIFProvenance"/>
         <body>CDIF Provenance profile module - documents prov:wasGeneratedBy on a Dataset as a sequence of ProvActivity items. Each ProvActivity extends the minimal prov:Activity with schema.org Action vocabulary (instruments, agents, temporal bounds, action chaining via schema:object back-references to earlier activities' schema:result). Conforms-to identifier: https://w3id.org/cdif/provenance/1.1.</body>
      </ownedComment>
      <name>CDIFProvenance</name>
      <URI>https://w3id.org/cdif/provenance/1.1/xmi/</URI>
      <packagedElement xmi:id="CDIFProvenance.ModelIdentification" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#ModelIdentification" xmi:type="uml:DataType">
