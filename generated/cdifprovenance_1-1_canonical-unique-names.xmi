         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFProvenance.ModelIdentification-title" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#ModelIdentification-title" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFProvenance.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFProvenance.ModelIdentification-title"/>
