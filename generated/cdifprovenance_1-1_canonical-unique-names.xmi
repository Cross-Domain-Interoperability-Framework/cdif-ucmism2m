            <lowerValue xmi:id="CDIFProvenance.ModelIdentification-title-lowerValue" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#ModelIdentification-title-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFProvenance.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>title</name>
            <defaultValue xmi:id="CDIFProvenance.ModelIdentification-title-defaultValue" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#ModelIdentification-title-defaultValue" xmi:type="uml:LiteralString">
               <value>UML Model for the CDIF Provenance Profile</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFProvenance.ModelIdentification-language" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#ModelIdentification-language" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFProvenance.ModelIdentification-language-ownedComment" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#ModelIdentification-language-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFProvenance.ModelIdentification-language"/>
               <body>Primary language of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFProvenance.ModelIdentification-language-lowerValue" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#ModelIdentification-language-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFProvenance.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
