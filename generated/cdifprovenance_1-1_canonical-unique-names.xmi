            <ownedComment xmi:id="CDIFProvenance.ModelIdentification-uri-ownedComment" xmi:uuid="https://w3id.org/cdif/provenance/1.1/xmi/#ModelIdentification-uri-ownedComment" xmi:type="uml:Comment">
