                     <value>1</value>
                  </upperValue>
                  <name>maintainer</name>
                  <type xmi:idref="CDIFProvenance.Agent"/>
                  <association xmi:idref="CDIFProvenance.CatalogRecord_maintainer_Agent"/>
               </ownedAttribute>
