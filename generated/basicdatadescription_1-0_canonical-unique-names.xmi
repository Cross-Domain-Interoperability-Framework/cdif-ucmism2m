         <ownedAttribute xmi:id="BasicDataDescription.ModelIdentification-title" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#ModelIdentification-title" xmi:type="uml:Property">
            <ownedComment xmi:id="BasicDataDescription.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
