                  </ownedComment>
                  <lowerValue xmi:id="BasicDataDescription.InstanceVariable-physicalDataType-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#InstanceVariable-physicalDataType-lowerValue" xmi:type="uml:LiteralInteger">
