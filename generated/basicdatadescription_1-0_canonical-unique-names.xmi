                  </ownedComment>
                  <lowerValue xmi:id="BasicDataDescription.InstanceVariable-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#InstanceVariable-identifier-lowerValue" xmi:type="uml:LiteralInteger">
