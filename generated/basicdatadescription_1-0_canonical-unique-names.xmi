            </ownedComment>
            <lowerValue xmi:id="BasicDataDescription.ModelIdentification-language-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#ModelIdentification-language-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="BasicDataDescription.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
