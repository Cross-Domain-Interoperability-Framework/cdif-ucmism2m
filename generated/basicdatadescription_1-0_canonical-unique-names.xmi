            <packagedElement xmi:id="BasicDataDescription.Dataset" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#Dataset" xmi:type="uml:Class">
               <ownedComment xmi:id="BasicDataDescription.Dataset-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#Dataset-ownedComment" xmi:type="uml:Comment">
