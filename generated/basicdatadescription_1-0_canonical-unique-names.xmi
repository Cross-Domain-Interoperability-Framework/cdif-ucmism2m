                     <body>cdif:formats_InstanceVariable - the InstanceVariable this mapping describes (by @id reference).</body>
                  </ownedComment>
                  <lowerValue xmi:id="BasicDataDescription.AbstractMapping-formats-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#AbstractMapping-formats-lowerValue" xmi:type="uml:LiteralInteger">
