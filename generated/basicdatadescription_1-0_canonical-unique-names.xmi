               </ownedComment>
               <name>GeoShape</name>
               <generalization xmi:id="BasicDataDescription.GeoShape-generalization-AbstractGeometry" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#GeoShape-generalization-AbstractGeometry" xmi:type="uml:Generalization">
