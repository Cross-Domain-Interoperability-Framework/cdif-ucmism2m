                     <annotatedElement xmi:idref="BasicDataDescription.AbstractMapping-identifier"/>
                     <body>@id - optional resolvable URI for this mapping (mappings are usually inline value objects but may be referenced when shared).</body>
                  </ownedComment>
                  <lowerValue xmi:id="BasicDataDescription.AbstractMapping-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#AbstractMapping-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="BasicDataDescription.AbstractMapping-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#AbstractMapping-identifier-upperValue" xmi:type="uml:LiteralInteger">
