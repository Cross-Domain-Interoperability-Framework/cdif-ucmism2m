            </lowerValue>
            <upperValue xmi:id="BasicDataDescription.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>title</name>
