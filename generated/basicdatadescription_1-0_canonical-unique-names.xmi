                  <annotatedElement xmi:idref="BasicDataDescription.InstanceVariable"/>
                  <body>A cdi:InstanceVariable as referenced by schema:variableMeasured. At Data Description level, every InstanceVariable must have an @id and a cdif:physicalDataType so physical mappings can reference it.</body>
               </ownedComment>
               <name>InstanceVariable</name>
               <ownedAttribute xmi:id="BasicDataDescription.InstanceVariable-identifier" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#InstanceVariable-identifier" xmi:type="uml:Property">
