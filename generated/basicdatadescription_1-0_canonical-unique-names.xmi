<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="BasicDataDescription.BasicDataDescription" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#BasicDataDescription">
      <ownedComment xmi:id="BasicDataDescription.BasicDataDescription-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#BasicDataDescription-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="BasicDataDescription.BasicDataDescription"/>
         <body>BasicDataDescription is a CDIF composite profile assembled from three building-block profile modules: cdifCore (the foundational schema:Dataset shape), cdifDiscovery (measurementTechnique, variableMeasured, spatialCoverage, temporalCoverage, hasQualityMeasurement) and cdifDataDescription (variable-level physical types, primary key, statistics, physical mappings on distributions). A metadata record validating against this composite must declare conformance to https://w3id.org/cdif/core/1.0, https://w3id.org/cdif/discovery/1.0, and https://w3id.org/cdif/data_description/1.0.</body>
      </ownedComment>
      <name>BasicDataDescription</name>
      <URI>https://w3id.org/cdif/data_description/1.0/composite/xmi/</URI>
      <packagedElement xmi:id="BasicDataDescription.ModelIdentification" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#ModelIdentification" xmi:type="uml:DataType">
         <ownedComment xmi:id="BasicDataDescription.ModelIdentification-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#ModelIdentification-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="BasicDataDescription.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="BasicDataDescription.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
