            <lowerValue xmi:id="BasicDataDescription.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="BasicDataDescription.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/composite/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>prefix</name>
