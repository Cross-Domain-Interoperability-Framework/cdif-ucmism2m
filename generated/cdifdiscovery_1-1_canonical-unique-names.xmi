                  <ownedComment xmi:id="CDIFDiscovery.VariableMeasured-measurementTechnique-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.1/xmi/#VariableMeasured-measurementTechnique-ownedComment" xmi:type="uml:Comment">
