                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDiscovery.Dataset-spatialCoverage-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.1/xmi/#Dataset-spatialCoverage-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
