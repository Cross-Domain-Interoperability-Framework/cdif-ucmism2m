                  <ownedComment xmi:id="CDIFDiscovery.Dataset-variableMeasured-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.1/xmi/#Dataset-variableMeasured-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDiscovery.Dataset-variableMeasured"/>
                     <body>Documentation
