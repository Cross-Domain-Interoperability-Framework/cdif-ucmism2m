                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDiscovery.Dataset-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.1/xmi/#Dataset-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFDiscovery.XsdAnyUri"/>
               </ownedAttribute>
