               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataDescription.InstanceVariable-unitOfMeasureKind" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-unitOfMeasureKind" xmi:type="uml:Property">
