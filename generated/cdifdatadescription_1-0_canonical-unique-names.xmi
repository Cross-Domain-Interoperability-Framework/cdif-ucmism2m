               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFDataDescription.DataDownload" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#DataDownload" xmi:type="uml:Class">
