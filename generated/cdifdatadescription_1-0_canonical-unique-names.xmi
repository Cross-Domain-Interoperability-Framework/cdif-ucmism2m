            <packagedElement xmi:id="CDIFDataDescription.DataDownload" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#DataDownload" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDataDescription.DataDownload-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#DataDownload-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataDescription.DataDownload"/>
                  <body>schema:DataDownload extended for the Data Description profile - adds the character-set attribute, the per-field physical mappings (cdif:hasPhysicalMapping), and a data fingerprint (cdi:fingerprint). File size is carried by the Core schema:contentSize attribute. Co-typed cdi:PhysicalDataSet in instances; TabularTextDataSet and StructuredDataSet specialize it for text-tabular and structured serializations. Composes with the core DataDownload at the model-composition step.</body>
               </ownedComment>
               <name>DataDownload</name>
               <generalization xmi:id="CDIFDataDescription.DataDownload-generalization-AbstractDistribution" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#DataDownload-generalization-AbstractDistribution" xmi:type="uml:Generalization">
