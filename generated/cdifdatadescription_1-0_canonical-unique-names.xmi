            <packagedElement xmi:id="CDIFDataDescription.InstanceVariable" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDataDescription.InstanceVariable-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataDescription.InstanceVariable"/>
                  <body>A cdi:InstanceVariable as referenced by schema:variableMeasured. At Data Description level, every InstanceVariable must have an @id and a cdif:physicalDataType so physical mappings can reference it.</body>
               </ownedComment>
               <name>InstanceVariable</name>
               <ownedAttribute xmi:id="CDIFDataDescription.InstanceVariable-identifier" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-identifier" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataDescription.InstanceVariable-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.InstanceVariable-identifier"/>
                     <body>@id - URI for this variable; target of cdif:formats_InstanceVariable references from physical mappings.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.InstanceVariable-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.InstanceVariable-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFDataDescription.XsdAnyUri"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataDescription.InstanceVariable-physicalDataType" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-physicalDataType" xmi:type="uml:Property">
