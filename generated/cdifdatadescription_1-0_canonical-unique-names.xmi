            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataDescription.ModelIdentification-language" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-language" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataDescription.ModelIdentification-language-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-language-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataDescription.ModelIdentification-language"/>
