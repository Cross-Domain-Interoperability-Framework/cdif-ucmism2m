                     <annotatedElement xmi:idref="CDIFDataDescription.AbstractMapping-formats"/>
                     <body>cdif:formats_InstanceVariable - the InstanceVariable this mapping describes (by @id reference).</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.AbstractMapping-formats-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#AbstractMapping-formats-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.AbstractMapping-formats-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#AbstractMapping-formats-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>formats</name>
                  <type xmi:idref="CDIFDataDescription.InstanceVariable"/>
                  <association xmi:idref="CDIFDataDescription.LocatorMapping_formats_InstanceVariable"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFDataDescription.PhysicalMapping" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#PhysicalMapping" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDataDescription.PhysicalMapping-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#PhysicalMapping-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataDescription.PhysicalMapping"/>
                  <body>Generic per-field physical mapping. Carries column index, format, physical data type, null sequence, etc., for a variable's representation in a file.</body>
