                     <annotatedElement xmi:idref="CDIFDataDescription.ActionResult-hasPhysicalMapping"/>
                     <body>cdif:hasPhysicalMapping - per-field physical mappings for the API response (which is another physical realization of the dataset's variables).</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.ActionResult-hasPhysicalMapping-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ActionResult-hasPhysicalMapping-lowerValue" xmi:type="uml:LiteralInteger">
