                  </upperValue>
                  <name>hasPhysicalMapping</name>
                  <type xmi:idref="CDIFDataDescription.AbstractMapping"/>
                  <association xmi:idref="CDIFDataDescription.DataDownload_hasPhysicalMapping_AbstractMapping"/>
               </ownedAttribute>
