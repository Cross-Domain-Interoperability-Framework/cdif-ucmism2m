                     <value>1</value>
                  </upperValue>
                  <name>formatPattern</name>
                  <type xmi:idref="CDIFDataDescription.Concept"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataDescription.ValueAndConceptDescription-identifier" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ValueAndConceptDescription-identifier" xmi:type="uml:Property">
