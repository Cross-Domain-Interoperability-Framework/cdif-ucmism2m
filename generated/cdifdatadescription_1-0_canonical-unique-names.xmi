            <packagedElement xmi:id="CDIFDataDescription.WebAPI" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#WebAPI" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDataDescription.WebAPI-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#WebAPI-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataDescription.WebAPI"/>
