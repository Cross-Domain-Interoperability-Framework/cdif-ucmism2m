               <ownedAttribute xmi:id="CDIFDataDescription.DataDownload-hasPhysicalMapping" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#DataDownload-hasPhysicalMapping" xmi:type="uml:Property" aggregation="composite">
