                     <annotatedElement xmi:idref="CDIFDataDescription.InstanceVariable-physicalDataType"/>
                     <body>cdif:physicalDataType - the physical representation type (string, decimal, integer, dateTime, ...). Required at Data Description level.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.InstanceVariable-physicalDataType-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-physicalDataType-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.InstanceVariable-physicalDataType-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-physicalDataType-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>physicalDataType</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataDescription.InstanceVariable-takesSubstantiveValuesFrom" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-takesSubstantiveValuesFrom" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataDescription.InstanceVariable-takesSubstantiveValuesFrom-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-takesSubstantiveValuesFrom-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.InstanceVariable-takesSubstantiveValuesFrom"/>
                     <body>cdi:takesSubstantiveValuesFrom - the substantive value domain for this variable.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.InstanceVariable-takesSubstantiveValuesFrom-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-takesSubstantiveValuesFrom-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.InstanceVariable-takesSubstantiveValuesFrom-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-takesSubstantiveValuesFrom-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>takesSubstantiveValuesFrom</name>
                  <type xmi:idref="CDIFDataDescription.SubstantiveValueDomain"/>
                  <association xmi:idref="CDIFDataDescription.InstanceVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataDescription.InstanceVariable-takesSentinelValuesFrom" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-takesSentinelValuesFrom" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataDescription.InstanceVariable-takesSentinelValuesFrom-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-takesSentinelValuesFrom-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.InstanceVariable-takesSentinelValuesFrom"/>
                     <body>cdi:takesSentinelValuesFrom - sentinel (missing / NA) value domain(s) for this variable.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.InstanceVariable-takesSentinelValuesFrom-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-takesSentinelValuesFrom-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.InstanceVariable-takesSentinelValuesFrom-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#InstanceVariable-takesSentinelValuesFrom-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>takesSentinelValuesFrom</name>
                  <type xmi:idref="CDIFDataDescription.SentinelValueDomain"/>
                  <association xmi:idref="CDIFDataDescription.InstanceVariable_takesSentinelValuesFrom_SentinelValueDomain"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFDataDescription.AbstractMapping" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#AbstractMapping" xmi:type="uml:Class" isAbstract="true">
               <ownedComment xmi:id="CDIFDataDescription.AbstractMapping-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#AbstractMapping-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataDescription.AbstractMapping"/>
                  <body>Abstract supertype for the cdif:hasPhysicalMapping family. Each concrete subtype maps a variable to a specific physical representation: PhysicalMapping (generic index-based), TextMapping (delimited / fixed-width text), LocatorMapping (locator string for structured data). Every concrete mapping carries a cdif:formats_InstanceVariable reference to the variable it describes.</body>
               </ownedComment>
               <name>AbstractMapping</name>
               <ownedAttribute xmi:id="CDIFDataDescription.AbstractMapping-identifier" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#AbstractMapping-identifier" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataDescription.AbstractMapping-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#AbstractMapping-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.AbstractMapping-identifier"/>
                     <body>@id - optional resolvable URI for this mapping (mappings are usually inline value objects but may be referenced when shared).</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.AbstractMapping-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#AbstractMapping-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.AbstractMapping-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#AbstractMapping-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFDataDescription.XsdAnyUri"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataDescription.AbstractMapping-formats" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#AbstractMapping-formats" xmi:type="uml:Property">
