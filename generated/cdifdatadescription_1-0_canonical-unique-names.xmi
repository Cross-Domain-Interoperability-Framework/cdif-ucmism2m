                     <annotatedElement xmi:idref="CDIFDataDescription.DataDownload-characterSet"/>
                     <body>cdi:characterSet - the character set used in the distribution (e.g. UTF-8, ASCII).</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.DataDownload-characterSet-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#DataDownload-characterSet-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.DataDownload-characterSet-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#DataDownload-characterSet-upperValue" xmi:type="uml:LiteralInteger">
