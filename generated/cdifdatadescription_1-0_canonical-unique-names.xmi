            <lowerValue xmi:id="CDIFDataDescription.ModelIdentification-minorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-minorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataDescription.ModelIdentification-minorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-minorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>minorVersion</name>
            <defaultValue xmi:id="CDIFDataDescription.ModelIdentification-minorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-minorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>0</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataDescription.ModelIdentification-title" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-title" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataDescription.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataDescription.ModelIdentification-title"/>
               <body>Title of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataDescription.ModelIdentification-title-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-title-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataDescription.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>title</name>
            <defaultValue xmi:id="CDIFDataDescription.ModelIdentification-title-defaultValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-title-defaultValue" xmi:type="uml:LiteralString">
