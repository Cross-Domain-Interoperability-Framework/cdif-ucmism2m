<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CDIFDataDescription.CDIFDataDescription" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#CDIFDataDescription">
      <ownedComment xmi:id="CDIFDataDescription.CDIFDataDescription-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#CDIFDataDescription-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFDataDescription.CDIFDataDescription"/>
         <body>CDIF Data Description profile module. On any Dataset whose catalog record declares conformance to https://w3id.org/cdif/data_description/1.0, this profile adds: (a) cdif:hasPrimaryKey on the Dataset, (b) cdif:statistics on the Dataset, (c) richer InstanceVariable shape (cdif:physicalDataType required, plus optional cdi:takesSubstantiveValuesFrom / cdi:takesSentinelValuesFrom value-domains), and (d) physical mapping on schema:distribution items - cdif:hasPhysicalMapping (any of PhysicalMapping / TextMapping / LocatorMapping) on DataDownload and on WebAPI's potentialAction.result, plus cdi:characterSet and cdi:fingerprint (DataFingerprint). A DataDownload MAY be co-typed cdi:TabularTextDataSet or cdi:StructuredDataSet.</body>
      </ownedComment>
      <name>CDIFDataDescription</name>
      <URI>https://w3id.org/cdif/data_description/1.0/xmi/</URI>
      <packagedElement xmi:id="CDIFDataDescription.ModelIdentification" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification" xmi:type="uml:DataType">
         <ownedComment xmi:id="CDIFDataDescription.ModelIdentification-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFDataDescription.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="CDIFDataDescription.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataDescription.ModelIdentification-prefix-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-prefix-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataDescription.ModelIdentification-prefix"/>
               <body>Namespace prefix of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataDescription.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataDescription.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>prefix</name>
            <defaultValue xmi:id="CDIFDataDescription.ModelIdentification-prefix-defaultValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-prefix-defaultValue" xmi:type="uml:LiteralString">
               <value>cdif</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataDescription.ModelIdentification-majorVersion" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-majorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataDescription.ModelIdentification-majorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-majorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataDescription.ModelIdentification-majorVersion"/>
               <body>Major version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataDescription.ModelIdentification-majorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-majorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataDescription.ModelIdentification-majorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-majorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>majorVersion</name>
            <defaultValue xmi:id="CDIFDataDescription.ModelIdentification-majorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-majorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataDescription.ModelIdentification-minorVersion" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-minorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataDescription.ModelIdentification-minorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-minorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataDescription.ModelIdentification-minorVersion"/>
               <body>Minor version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataDescription.ModelIdentification-minorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-minorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataDescription.ModelIdentification-minorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-minorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>minorVersion</name>
            <defaultValue xmi:id="CDIFDataDescription.ModelIdentification-minorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-minorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>0</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataDescription.ModelIdentification-title" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-title" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataDescription.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataDescription.ModelIdentification-title"/>
               <body>Title of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataDescription.ModelIdentification-title-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-title-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataDescription.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>title</name>
            <defaultValue xmi:id="CDIFDataDescription.ModelIdentification-title-defaultValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-title-defaultValue" xmi:type="uml:LiteralString">
               <value>UML Model for the CDIF Data Description Profile</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataDescription.ModelIdentification-language" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-language" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataDescription.ModelIdentification-language-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-language-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataDescription.ModelIdentification-language"/>
               <body>Primary language of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataDescription.ModelIdentification-language-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-language-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataDescription.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>language</name>
            <defaultValue xmi:id="CDIFDataDescription.ModelIdentification-language-defaultValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-language-defaultValue" xmi:type="uml:LiteralString">
               <value>en</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataDescription.ModelIdentification-uri" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-uri" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataDescription.ModelIdentification-uri-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-uri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataDescription.ModelIdentification-uri"/>
               <body>Namespace URI of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataDescription.ModelIdentification-uri-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-uri-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataDescription.ModelIdentification-uri-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-uri-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>uri</name>
            <defaultValue xmi:id="CDIFDataDescription.ModelIdentification-uri-defaultValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-uri-defaultValue" xmi:type="uml:LiteralString">
               <value>https://w3id.org/cdif/data_description/1.0/xmi/</value>
            </defaultValue>
