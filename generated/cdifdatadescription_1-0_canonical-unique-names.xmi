            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:id="CDIFDataDescription.CDIFDataDescriptionPackage" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#CDIFDataDescription-package" xmi:type="uml:Package">
         <ownedComment xmi:id="CDIFDataDescription.CDIFDataDescriptionPackage-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#CDIFDataDescription-package-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFDataDescription.CDIFDataDescriptionPackage"/>
            <body>Data Description profile additions: variable-level physical types, primary keys, statistics, distribution-level physical mappings.</body>
         </ownedComment>
         <name>CDIFDataDescription</name>
         <packagedElement xmi:id="CDIFDataDescription.XsdAnyUri" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#XsdAnyUri" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFDataDescription.XsdAnyUri-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#XsdAnyUri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataDescription.XsdAnyUri"/>
               <body>Primitive data type "anyURI" of the XML Schema data types.

Definition from XML Schema Part 2: Datatypes Second Edition: "anyURI" represents a Uniform Resource Identifier Reference (URI). An "anyURI" value can be absolute or relative, and may have an optional fragment identifier (i.e., it may be a URI Reference). This type should be used to specify the intention that the value fulfills the role of a URI as defined by [RFC 2396], as amended by [RFC 2732]. For details see https://www.w3.org/TR/xmlschema-2/#anyURI.</body>
            </ownedComment>
            <name>XsdAnyUri</name>
         </packagedElement>
         <packagedElement xmi:id="CDIFDataDescription.Classes" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Classes-package" xmi:type="uml:Package">
            <ownedComment xmi:id="CDIFDataDescription.Classes-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Classes-package-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataDescription.Classes"/>
               <body>Target classes of the CDIF profile.</body>
            </ownedComment>
            <name>Classes</name>
            <packagedElement xmi:id="CDIFDataDescription.Dataset" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDataDescription.Dataset-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataDescription.Dataset"/>
                  <body>Stub of schema:Dataset (full definition in CDIFCore). Re-declared so the diagram can render the data-description-specific edges.</body>
               </ownedComment>
               <name>Dataset</name>
               <ownedAttribute xmi:id="CDIFDataDescription.Dataset-identifier" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-identifier" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataDescription.Dataset-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.Dataset-identifier"/>
                     <body>@id - resolvable URI for the dataset.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.Dataset-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.Dataset-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFDataDescription.XsdAnyUri"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataDescription.Dataset-subjectOf" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-subjectOf" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFDataDescription.Dataset-subjectOf-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-subjectOf-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.Dataset-subjectOf"/>
                     <body>schema:subjectOf - the catalog record describing this dataset's metadata. MUST declare conformance to https://w3id.org/cdif/data_description/1.0.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.Dataset-subjectOf-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-subjectOf-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.Dataset-subjectOf-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-subjectOf-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>subjectOf</name>
                  <type xmi:idref="CDIFDataDescription.CatalogRecord"/>
                  <association xmi:idref="CDIFDataDescription.Dataset_subjectOf_CatalogRecord"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataDescription.Dataset-variableMeasured" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-variableMeasured" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFDataDescription.Dataset-variableMeasured-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-variableMeasured-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.Dataset-variableMeasured"/>
                     <body>schema:variableMeasured - the variables described by this dataset. Required.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.Dataset-variableMeasured-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-variableMeasured-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.Dataset-variableMeasured-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-variableMeasured-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>variableMeasured</name>
                  <type xmi:idref="CDIFDataDescription.InstanceVariable"/>
                  <association xmi:idref="CDIFDataDescription.Dataset_variableMeasured_InstanceVariable"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataDescription.Dataset-hasPrimaryKey" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-hasPrimaryKey" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFDataDescription.Dataset-hasPrimaryKey-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-hasPrimaryKey-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.Dataset-hasPrimaryKey"/>
                     <body>cdif:hasPrimaryKey - the primary key of the dataset.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.Dataset-hasPrimaryKey-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-hasPrimaryKey-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.Dataset-hasPrimaryKey-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-hasPrimaryKey-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>hasPrimaryKey</name>
                  <type xmi:idref="CDIFDataDescription.PrimaryKey"/>
                  <association xmi:idref="CDIFDataDescription.Dataset_hasPrimaryKey_PrimaryKey"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataDescription.Dataset-statistics" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-statistics" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFDataDescription.Dataset-statistics-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-statistics-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.Dataset-statistics"/>
                     <body>cdif:statistics - summary statistics describing the dataset's values.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.Dataset-statistics-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-statistics-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.Dataset-statistics-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-statistics-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>statistics</name>
                  <type xmi:idref="CDIFDataDescription.Statistics"/>
                  <association xmi:idref="CDIFDataDescription.Dataset_statistics_Statistics"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataDescription.Dataset-distribution" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-distribution" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFDataDescription.Dataset-distribution-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-distribution-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.Dataset-distribution"/>
                     <body>schema:distribution - a downloadable distribution. May be co-typed cdi:TabularTextDataSet or cdi:StructuredDataSet (see AbstractDataSet subtypes).</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.Dataset-distribution-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-distribution-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.Dataset-distribution-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-distribution-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>distribution</name>
                  <type xmi:idref="CDIFDataDescription.DataDownload"/>
                  <association xmi:idref="CDIFDataDescription.Dataset_distribution_DataDownload"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataDescription.Dataset-distribution" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-distribution" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFDataDescription.Dataset-distribution-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-distribution-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.Dataset-distribution"/>
                     <body>schema:distribution - a WebAPI distribution. Per-field mappings attach to the WebAPI's potentialAction.result (see ActionResult).</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.Dataset-distribution-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-distribution-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.Dataset-distribution-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#Dataset-distribution-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>distribution</name>
                  <type xmi:idref="CDIFDataDescription.WebAPI"/>
                  <association xmi:idref="CDIFDataDescription.Dataset_distribution_WebAPI"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFDataDescription.CatalogRecord" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#CatalogRecord" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDataDescription.CatalogRecord-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#CatalogRecord-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataDescription.CatalogRecord"/>
                  <body>Stub of CDIFCore::CatalogRecord. For the data-description profile, dcterms:conformsTo MUST include https://w3id.org/cdif/data_description/1.0.</body>
               </ownedComment>
               <name>CatalogRecord</name>
