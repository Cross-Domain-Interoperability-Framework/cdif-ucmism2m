                  <name>maximumValueExclusive</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataDescription.ValueAndConceptDescription-maximumValueInclusive" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ValueAndConceptDescription-maximumValueInclusive" xmi:type="uml:Property">
