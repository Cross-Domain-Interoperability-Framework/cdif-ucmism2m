                     <annotatedElement xmi:idref="CDIFDataDescription.DataDownload-hasPhysicalMapping"/>
                     <body>cdif:hasPhysicalMapping - per-field physical mappings linking variables to their on-disk representation. Each item is one of PhysicalMapping / TextMapping / LocatorMapping.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.DataDownload-hasPhysicalMapping-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#DataDownload-hasPhysicalMapping-lowerValue" xmi:type="uml:LiteralInteger">
