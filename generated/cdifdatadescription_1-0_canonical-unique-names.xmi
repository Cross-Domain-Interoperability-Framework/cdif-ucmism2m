            <lowerValue xmi:id="CDIFDataDescription.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.0/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
