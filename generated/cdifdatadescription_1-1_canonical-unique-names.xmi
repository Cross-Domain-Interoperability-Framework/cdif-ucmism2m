                     <annotatedElement xmi:idref="CDIFDataDescription.CdifConceptOrTermOrString-identifier"/>
                     <body>@id - resolvable URI when the concept-or-term branch is used; absent when the value is a plain string.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.CdifConceptOrTermOrString-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#CdifConceptOrTermOrString-identifier-lowerValue" xmi:type="uml:LiteralInteger">
