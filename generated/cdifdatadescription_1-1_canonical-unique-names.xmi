                  <ownedComment xmi:id="CDIFDataDescription.PhysicalMapping-physicalDataType-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#PhysicalMapping-physicalDataType-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.PhysicalMapping-physicalDataType"/>
