                  <ownedComment xmi:id="CDIFDataDescription.ValueAndConceptDescription-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#ValueAndConceptDescription-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.ValueAndConceptDescription-identifier"/>
                     <body>Documentation
