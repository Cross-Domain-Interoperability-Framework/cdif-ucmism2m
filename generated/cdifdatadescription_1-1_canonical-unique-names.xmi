            <packagedElement xmi:id="CDIFDataDescription.CdifConceptOrTerm" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#CdifConceptOrTerm" xmi:type="uml:DataType">
               <ownedComment xmi:id="CDIFDataDescription.CdifConceptOrTerm-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#CdifConceptOrTerm-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataDescription.CdifConceptOrTerm"/>
                  <body>Union shorthand for 'a concept reference (skos:Concept) OR a defined term (schema:DefinedTerm)'. In JSON instances the value MAY be: (a) an inline object, (b) an @id-only object, or (c) a plain string interpreted as the @id / prefLabel / termCode of the underlying reference.</body>
               </ownedComment>
               <name>CdifConceptOrTerm</name>
               <ownedAttribute xmi:id="CDIFDataDescription.CdifConceptOrTerm-identifier" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#CdifConceptOrTerm-identifier" xmi:type="uml:Property">
