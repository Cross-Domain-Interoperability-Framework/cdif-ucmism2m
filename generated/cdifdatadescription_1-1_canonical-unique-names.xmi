                     <body>@id - resolvable URI of the concept or term.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.CdifConceptOrTerm-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#CdifConceptOrTerm-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.CdifConceptOrTerm-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#CdifConceptOrTerm-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFDataDescription.XsdAnyUri"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFDataDescription.CdifConceptOrTermOrString" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#CdifConceptOrTermOrString" xmi:type="uml:DataType">
