                     <annotatedElement xmi:idref="CDIFDataDescription.AbstractMapping-formats"/>
                     <body>cdif:formats_InstanceVariable - the InstanceVariable this mapping describes.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataDescription.AbstractMapping-formats-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#AbstractMapping-formats-lowerValue" xmi:type="uml:LiteralInteger">
