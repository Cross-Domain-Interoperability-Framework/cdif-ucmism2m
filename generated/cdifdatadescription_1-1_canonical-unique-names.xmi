               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataDescription.ModelIdentification-minorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#ModelIdentification-minorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
