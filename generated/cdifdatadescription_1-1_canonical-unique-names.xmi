                  <ownedComment xmi:id="CDIFDataDescription.TabularTextDataSet-hasHeader-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#TabularTextDataSet-hasHeader-ownedComment" xmi:type="uml:Comment">
