            <lowerValue xmi:id="CDIFDataDescription.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataDescription.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>prefix</name>
            <defaultValue xmi:id="CDIFDataDescription.ModelIdentification-prefix-defaultValue" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#ModelIdentification-prefix-defaultValue" xmi:type="uml:LiteralString">
               <value>cdif</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataDescription.ModelIdentification-majorVersion" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#ModelIdentification-majorVersion" xmi:type="uml:Property">
