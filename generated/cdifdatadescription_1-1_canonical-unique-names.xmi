      <packagedElement xmi:id="CDIFDataDescription.CDIFDataDescriptionPackage" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#CDIFDataDescription-package" xmi:type="uml:Package">
         <ownedComment xmi:id="CDIFDataDescription.CDIFDataDescriptionPackage-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#CDIFDataDescription-package-ownedComment" xmi:type="uml:Comment">
