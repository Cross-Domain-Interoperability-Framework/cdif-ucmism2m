                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataDescription.InstanceVariable-measurementTechnique-DefinedTerm-upperValue" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#InstanceVariable-measurementTechnique-DefinedTerm-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
