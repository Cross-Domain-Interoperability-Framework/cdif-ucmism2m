                  <ownedComment xmi:id="CDIFDataDescription.InstanceVariable-measurementTechnique-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#InstanceVariable-measurementTechnique-ownedComment" xmi:type="uml:Comment">
