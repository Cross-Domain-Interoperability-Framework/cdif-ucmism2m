                  <ownedComment xmi:id="CDIFDataDescription.SentinelValueDomain-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#SentinelValueDomain-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataDescription.SentinelValueDomain-identifier"/>
                     <body>Documentation
