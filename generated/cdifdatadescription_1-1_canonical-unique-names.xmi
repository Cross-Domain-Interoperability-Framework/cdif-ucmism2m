<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CDIFDataDescription.CDIFDataDescription" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#CDIFDataDescription">
      <ownedComment xmi:id="CDIFDataDescription.CDIFDataDescription-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#CDIFDataDescription-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFDataDescription.CDIFDataDescription"/>
         <body>CDIF Data Description profile module - adds: (a) cdif:hasPrimaryKey on the Dataset, (b) cdif:statistics on the Dataset, (c) richer InstanceVariable shape (cdif:physicalDataType required, value domains, units, function, source, concept-or-term references via cdif:uses), and (d) physical mapping on distribution items (PhysicalMapping / TextMapping / LocatorMapping), DataFingerprint, and cdi:characterSet on DataDownload + WebAPI's potentialAction.result.</body>
      </ownedComment>
      <name>CDIFDataDescription</name>
      <URI>https://w3id.org/cdif/data_description/1.1/xmi/</URI>
      <packagedElement xmi:id="CDIFDataDescription.ModelIdentification" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#ModelIdentification" xmi:type="uml:DataType">
         <ownedComment xmi:id="CDIFDataDescription.ModelIdentification-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#ModelIdentification-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFDataDescription.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="CDIFDataDescription.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
