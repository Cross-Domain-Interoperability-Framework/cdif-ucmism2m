               <ownedComment xmi:id="CDIFDataDescription.SentinelValueDomain-ownedComment" xmi:uuid="https://w3id.org/cdif/data_description/1.1/xmi/#SentinelValueDomain-ownedComment" xmi:type="uml:Comment">
