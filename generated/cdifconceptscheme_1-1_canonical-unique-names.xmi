<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CDIFConceptScheme.CDIFConceptScheme" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#CDIFConceptScheme">
      <ownedComment xmi:id="CDIFConceptScheme.CDIFConceptScheme-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#CDIFConceptScheme-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFConceptScheme.CDIFConceptScheme"/>
         <body>CDIF profile module for SKOS concept schemes used as controlled vocabularies in CDIF metadata. Thin wrapper around skosConceptScheme. Required attributes per the profile JSON schema: ConceptScheme has @type (containing skos:ConceptScheme), skos:prefLabel, skos:definition, skos:hasTopConcept (minItems 1); Concept has @type (containing skos:Concept), skos:prefLabel, skos:notation. The catalog record (schema:subjectOf &gt; CatalogRecord) MUST declare conformance to https://w3id.org/cdif/conceptscheme/1.1.</body>
      </ownedComment>
      <name>CDIFConceptScheme</name>
      <URI>https://w3id.org/cdif/conceptscheme/1.1/xmi/</URI>
      <packagedElement xmi:id="CDIFConceptScheme.ModelIdentification" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification" xmi:type="uml:DataType">
         <ownedComment xmi:id="CDIFConceptScheme.ModelIdentification-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFConceptScheme.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="CDIFConceptScheme.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFConceptScheme.ModelIdentification-prefix-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-prefix-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFConceptScheme.ModelIdentification-prefix"/>
               <body>Namespace prefix of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFConceptScheme.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFConceptScheme.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>prefix</name>
            <defaultValue xmi:id="CDIFConceptScheme.ModelIdentification-prefix-defaultValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-prefix-defaultValue" xmi:type="uml:LiteralString">
               <value>cdif</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFConceptScheme.ModelIdentification-majorVersion" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-majorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFConceptScheme.ModelIdentification-majorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-majorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFConceptScheme.ModelIdentification-majorVersion"/>
               <body>Major version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFConceptScheme.ModelIdentification-majorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-majorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFConceptScheme.ModelIdentification-majorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-majorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>majorVersion</name>
            <defaultValue xmi:id="CDIFConceptScheme.ModelIdentification-majorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-majorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFConceptScheme.ModelIdentification-minorVersion" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-minorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFConceptScheme.ModelIdentification-minorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-minorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFConceptScheme.ModelIdentification-minorVersion"/>
               <body>Minor version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFConceptScheme.ModelIdentification-minorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-minorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFConceptScheme.ModelIdentification-minorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-minorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>minorVersion</name>
            <defaultValue xmi:id="CDIFConceptScheme.ModelIdentification-minorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-minorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFConceptScheme.ModelIdentification-title" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-title" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFConceptScheme.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFConceptScheme.ModelIdentification-title"/>
               <body>Title of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFConceptScheme.ModelIdentification-title-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-title-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFConceptScheme.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>title</name>
            <defaultValue xmi:id="CDIFConceptScheme.ModelIdentification-title-defaultValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-title-defaultValue" xmi:type="uml:LiteralString">
               <value>UML Model for the CDIF ConceptScheme Profile</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFConceptScheme.ModelIdentification-language" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-language" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFConceptScheme.ModelIdentification-language-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-language-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFConceptScheme.ModelIdentification-language"/>
               <body>Primary language of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFConceptScheme.ModelIdentification-language-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-language-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFConceptScheme.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>language</name>
            <defaultValue xmi:id="CDIFConceptScheme.ModelIdentification-language-defaultValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-language-defaultValue" xmi:type="uml:LiteralString">
               <value>en</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFConceptScheme.ModelIdentification-uri" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-uri" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFConceptScheme.ModelIdentification-uri-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-uri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFConceptScheme.ModelIdentification-uri"/>
               <body>Namespace URI of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFConceptScheme.ModelIdentification-uri-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-uri-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFConceptScheme.ModelIdentification-uri-upperValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-uri-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>uri</name>
            <defaultValue xmi:id="CDIFConceptScheme.ModelIdentification-uri-defaultValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ModelIdentification-uri-defaultValue" xmi:type="uml:LiteralString">
               <value>https://w3id.org/cdif/conceptscheme/1.1/xmi/</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:id="CDIFConceptScheme.CDIFConceptSchemePackage" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#CDIFConceptScheme-package" xmi:type="uml:Package">
         <ownedComment xmi:id="CDIFConceptScheme.CDIFConceptSchemePackage-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#CDIFConceptScheme-package-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFConceptScheme.CDIFConceptSchemePackage"/>
            <body>Profile module for SKOS concept schemes used as controlled vocabularies in CDIF metadata.</body>
         </ownedComment>
         <name>CDIFConceptScheme</name>
         <packagedElement xmi:id="CDIFConceptScheme.XsdAnyUri" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#XsdAnyUri" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFConceptScheme.XsdAnyUri-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#XsdAnyUri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFConceptScheme.XsdAnyUri"/>
               <body>Primitive data type "anyURI" of the XML Schema data types.

Definition from XML Schema Part 2: Datatypes Second Edition: "anyURI" represents a Uniform Resource Identifier Reference (URI). An "anyURI" value can be absolute or relative, and may have an optional fragment identifier (i.e., it may be a URI Reference). This type should be used to specify the intention that the value fulfills the role of a URI as defined by [RFC 2396], as amended by [RFC 2732]. For details see https://www.w3.org/TR/xmlschema-2/#anyURI.</body>
            </ownedComment>
            <name>XsdAnyUri</name>
         </packagedElement>
         <packagedElement xmi:id="CDIFConceptScheme.Classes" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#Classes-package" xmi:type="uml:Package">
            <ownedComment xmi:id="CDIFConceptScheme.Classes-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#Classes-package-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFConceptScheme.Classes"/>
               <body>Target classes of the CDIF profile.</body>
            </ownedComment>
            <name>Classes</name>
            <packagedElement xmi:id="CDIFConceptScheme.ConceptScheme" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFConceptScheme.ConceptScheme-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFConceptScheme.ConceptScheme"/>
                  <body>A SKOS Concept Scheme - a controlled vocabulary aggregating one or more SKOS Concepts. Required attributes: @type (containing skos:ConceptScheme), skos:prefLabel, skos:definition, skos:hasTopConcept (at least one). The metadata record describing this scheme (schema:subjectOf &gt; CatalogRecord) MUST declare conformance to https://w3id.org/cdif/conceptscheme/1.1.</body>
               </ownedComment>
               <name>ConceptScheme</name>
               <ownedAttribute xmi:id="CDIFConceptScheme.ConceptScheme-identifier" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-identifier" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFConceptScheme.ConceptScheme-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFConceptScheme.ConceptScheme-identifier"/>
                     <body>@id - URI identifier for this concept scheme.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFConceptScheme.ConceptScheme-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFConceptScheme.ConceptScheme-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFConceptScheme.XsdAnyUri"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFConceptScheme.ConceptScheme-prefLabel" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-prefLabel" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFConceptScheme.ConceptScheme-prefLabel-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-prefLabel-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFConceptScheme.ConceptScheme-prefLabel"/>
                     <body>skos:prefLabel - preferred lexical label for the concept scheme. Required. May be a plain string or a language-tagged value (LanguageTaggedValue is collapsed to String per the union-type policy).</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFConceptScheme.ConceptScheme-prefLabel-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-prefLabel-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFConceptScheme.ConceptScheme-prefLabel-upperValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-prefLabel-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>prefLabel</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFConceptScheme.ConceptScheme-altLabel" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-altLabel" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFConceptScheme.ConceptScheme-altLabel-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-altLabel-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFConceptScheme.ConceptScheme-altLabel"/>
                     <body>skos:altLabel - alternative lexical labels (acronyms, abbreviations, spelling variants).</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFConceptScheme.ConceptScheme-altLabel-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-altLabel-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFConceptScheme.ConceptScheme-altLabel-upperValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-altLabel-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>altLabel</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFConceptScheme.ConceptScheme-definition" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-definition" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFConceptScheme.ConceptScheme-definition-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-definition-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFConceptScheme.ConceptScheme-definition"/>
                     <body>skos:definition - formal explanation of the meaning or purpose of this concept scheme. Required.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFConceptScheme.ConceptScheme-definition-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-definition-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFConceptScheme.ConceptScheme-definition-upperValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-definition-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>definition</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFConceptScheme.ConceptScheme-notation" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-notation" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFConceptScheme.ConceptScheme-notation-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-notation-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFConceptScheme.ConceptScheme-notation"/>
                     <body>skos:notation - classification code or notation for this concept scheme.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFConceptScheme.ConceptScheme-notation-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-notation-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFConceptScheme.ConceptScheme-notation-upperValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-notation-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>notation</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFConceptScheme.ConceptScheme-note" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-note" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFConceptScheme.ConceptScheme-note-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-note-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFConceptScheme.ConceptScheme-note"/>
                     <body>skos:note - general note about the concept scheme.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFConceptScheme.ConceptScheme-note-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-note-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFConceptScheme.ConceptScheme-note-upperValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-note-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>note</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFConceptScheme.ConceptScheme-version" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-version" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFConceptScheme.ConceptScheme-version-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-version-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFConceptScheme.ConceptScheme-version"/>
                     <body>schema:version - version identifier for the concept scheme.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFConceptScheme.ConceptScheme-version-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-version-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFConceptScheme.ConceptScheme-version-upperValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-version-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>version</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFConceptScheme.ConceptScheme-subjectOf" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-subjectOf" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFConceptScheme.ConceptScheme-subjectOf-ownedComment" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-subjectOf-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFConceptScheme.ConceptScheme-subjectOf"/>
                     <body>schema:subjectOf - the catalog record describing this concept scheme's metadata. For a CDIF concept scheme, the CatalogRecord MUST declare conformance to https://w3id.org/cdif/conceptscheme/1.1.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFConceptScheme.ConceptScheme-subjectOf-lowerValue" xmi:uuid="https://w3id.org/cdif/conceptscheme/1.1/xmi/#ConceptScheme-subjectOf-lowerValue" xmi:type="uml:LiteralInteger">
