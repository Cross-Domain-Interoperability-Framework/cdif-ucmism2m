                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.PrimaryKeyComponent-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PrimaryKeyComponent-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.PrimaryKeyComponent-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PrimaryKeyComponent-identifier-upperValue" xmi:type="uml:LiteralInteger">
