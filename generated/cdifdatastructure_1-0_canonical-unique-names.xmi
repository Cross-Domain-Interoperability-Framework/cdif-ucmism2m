                     <body>A human-readable display label for the object. Supports the use of multiple languages. Repeat for labels with different content, for example, labels with differing length limitations.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.SentinelValueDomain-displayLabel-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#SentinelValueDomain-displayLabel-lowerValue" xmi:type="uml:LiteralInteger">
