                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.TabularTextDataSet-fileSize-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#TabularTextDataSet-fileSize-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.TabularTextDataSet-fileSize-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#TabularTextDataSet-fileSize-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>fileSize</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Real"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.TabularTextDataSet-fileSizeUofM" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#TabularTextDataSet-fileSizeUofM" xmi:type="uml:Property">
