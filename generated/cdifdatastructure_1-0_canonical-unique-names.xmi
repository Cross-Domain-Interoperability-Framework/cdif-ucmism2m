            <ownedAttribute xmi:id="CDIFDataStructure.ProvenanceInformation-recordLastRevisionDate" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ProvenanceInformation-recordLastRevisionDate" xmi:type="uml:Property">
               <ownedComment xmi:id="CDIFDataStructure.ProvenanceInformation-recordLastRevisionDate-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ProvenanceInformation-recordLastRevisionDate-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.ProvenanceInformation-recordLastRevisionDate"/>
                  <body>Date the record was last revised.</body>
               </ownedComment>
               <lowerValue xmi:id="CDIFDataStructure.ProvenanceInformation-recordLastRevisionDate-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ProvenanceInformation-recordLastRevisionDate-lowerValue" xmi:type="uml:LiteralInteger">
