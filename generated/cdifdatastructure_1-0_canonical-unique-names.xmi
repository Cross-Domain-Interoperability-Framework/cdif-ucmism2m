                     <annotatedElement xmi:idref="CDIFDataStructure.InstanceVariable-takesSentinelValuesFrom"/>
                     <body>cdi:takesSentinelValuesFrom - the sentinel (missing / not-applicable) value domain(s) for this variable.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.InstanceVariable-takesSentinelValuesFrom-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InstanceVariable-takesSentinelValuesFrom-lowerValue" xmi:type="uml:LiteralInteger">
