               </ownedComment>
               <lowerValue xmi:id="CDIFDataStructure.LanguageString-structureUsed-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-structureUsed-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="CDIFDataStructure.LanguageString-structureUsed-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-structureUsed-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>structureUsed</name>
               <type xmi:idref="CDIFDataStructure.ControlledVocabularyEntry"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="CDIFDataStructure.LanguageString-translationDate" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#LanguageString-translationDate" xmi:type="uml:Property">
