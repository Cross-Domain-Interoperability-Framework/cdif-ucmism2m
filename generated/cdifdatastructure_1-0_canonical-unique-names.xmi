               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.DescriptorVariable-name" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DescriptorVariable-name" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.DescriptorVariable-name-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DescriptorVariable-name-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.DescriptorVariable-name"/>
                     <body>Human understandable name (linguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.DescriptorVariable-name-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DescriptorVariable-name-lowerValue" xmi:type="uml:LiteralInteger">
