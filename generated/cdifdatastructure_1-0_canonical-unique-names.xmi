                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.DescriptorVariable-name-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DescriptorVariable-name-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
