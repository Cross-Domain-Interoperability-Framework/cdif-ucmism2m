                     <annotatedElement xmi:idref="CDIFDataStructure.PrimaryKey-identifier"/>
                     <body>@id - resolvable URI for this primary key.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.PrimaryKey-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PrimaryKey-identifier-lowerValue" xmi:type="uml:LiteralInteger">
