            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
