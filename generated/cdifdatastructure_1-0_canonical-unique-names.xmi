<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CDIFDataStructure.CDIFDataStructure" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CDIFDataStructure">
      <ownedComment xmi:id="CDIFDataStructure.CDIFDataStructure-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CDIFDataStructure-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFDataStructure.CDIFDataStructure"/>
         <body>CDIF Data Structure profile module. Adds cdi:isStructuredBy on a DataDownload, pointing at one of four DataStructure variants - DataStructure (general; any component subtype), DimensionalDataStructure (Identifier/Measure/Attribute/Dimension), LongDataStructure (Identifier/VariableDescriptor/VariableValue/Attribute), WideDataStructure (Identifier/Measure/Attribute). Each structure may also carry a PrimaryKey and ForeignKeys. RepresentedVariables carry value domains (substantive / sentinel), an intended data type, a unit type (measures), and concept references (cdif:uses -&gt; CdifConceptOrTerm). The catalog record (schema:subjectOf &gt; CatalogRecord) MUST declare conformance to https://w3id.org/cdif/data_structure/1.0.</body>
      </ownedComment>
      <name>CDIFDataStructure</name>
      <URI>https://w3id.org/cdif/data_structure/1.0/xmi/</URI>
      <packagedElement xmi:id="CDIFDataStructure.ModelIdentification" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification" xmi:type="uml:DataType">
         <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-prefix-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-prefix"/>
               <body>Namespace prefix of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataStructure.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>prefix</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-prefix-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix-defaultValue" xmi:type="uml:LiteralString">
               <value>cdif</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-majorVersion" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-majorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-majorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-majorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-majorVersion"/>
               <body>Major version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataStructure.ModelIdentification-majorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-majorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-majorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-majorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>majorVersion</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-majorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-majorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-minorVersion" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-minorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-minorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-minorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-minorVersion"/>
               <body>Minor version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataStructure.ModelIdentification-minorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-minorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-minorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-minorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>minorVersion</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-minorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-minorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>0</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-title" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-title" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-title"/>
               <body>Title of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataStructure.ModelIdentification-title-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-title-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>title</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-title-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-title-defaultValue" xmi:type="uml:LiteralString">
               <value>UML Model for the CDIF Data Structure Profile</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-language" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-language" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-language-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-language-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-language"/>
               <body>Primary language of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataStructure.ModelIdentification-language-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-language-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>language</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-language-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-language-defaultValue" xmi:type="uml:LiteralString">
               <value>en</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-uri" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-uri" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-uri-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-uri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-uri"/>
               <body>Namespace URI of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataStructure.ModelIdentification-uri-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-uri-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-uri-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-uri-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>uri</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-uri-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-uri-defaultValue" xmi:type="uml:LiteralString">
               <value>https://w3id.org/cdif/data_structure/1.0/xmi/</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:id="CDIFDataStructure.CDIFDataStructurePackage" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CDIFDataStructure-package" xmi:type="uml:Package">
         <ownedComment xmi:id="CDIFDataStructure.CDIFDataStructurePackage-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CDIFDataStructure-package-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFDataStructure.CDIFDataStructurePackage"/>
            <body>Data structure description extension classes added by this profile.</body>
         </ownedComment>
         <name>CDIFDataStructure</name>
         <packagedElement xmi:id="CDIFDataStructure.XsdAnyUri" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#XsdAnyUri" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFDataStructure.XsdAnyUri-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#XsdAnyUri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.XsdAnyUri"/>
               <body>Primitive data type "anyURI" of the XML Schema data types.

Definition from XML Schema Part 2: Datatypes Second Edition: "anyURI" represents a Uniform Resource Identifier Reference (URI). An "anyURI" value can be absolute or relative, and may have an optional fragment identifier (i.e., it may be a URI Reference). This type should be used to specify the intention that the value fulfills the role of a URI as defined by [RFC 2396], as amended by [RFC 2732]. For details see https://www.w3.org/TR/xmlschema-2/#anyURI.</body>
            </ownedComment>
            <name>XsdAnyUri</name>
         </packagedElement>
         <packagedElement xmi:id="CDIFDataStructure.ControlledVocabularyEntry" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFDataStructure.ControlledVocabularyEntry-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ControlledVocabularyEntry"/>
               <body>Allows for unstructured content which may be an entry from an externally maintained controlled vocabulary.If the content is from a controlled vocabulary provide the code value of the entry, as well as a reference to the controlled vocabulary from which the value is taken. Provide as many of the identifying attributes as needed to adequately identify the controlled vocabulary. Note that DDI has published a number of controlled vocabularies applicable to several locations using the external controlled vocabulary entry structure. If the code portion of the controlled vocabulary entry is language specific (i.e. a list of keywords or subject headings) use language to specify that language. In most cases the code portion of an entry is not language specific although the description and usage may be managed in one or more languages. Use of shared controlled vocabularies helps support interoperability and machine actionability.</body>
            </ownedComment>
            <name>ControlledVocabularyEntry</name>
            <ownedAttribute xmi:id="CDIFDataStructure.ControlledVocabularyEntry-entryReference" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-entryReference" xmi:type="uml:Property">
               <ownedComment xmi:id="CDIFDataStructure.ControlledVocabularyEntry-entryReference-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-entryReference-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.ControlledVocabularyEntry-entryReference"/>
                  <body>A reference to the specific item in the vocabulary referenced in the vocabulary attribute, using a URI or other resolvable identifier.</body>
               </ownedComment>
               <lowerValue xmi:id="CDIFDataStructure.ControlledVocabularyEntry-entryReference-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-entryReference-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="CDIFDataStructure.ControlledVocabularyEntry-entryReference-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-entryReference-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                  <value>*</value>
               </upperValue>
               <name>entryReference</name>
               <type xmi:idref="CDIFDataStructure.Reference"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="CDIFDataStructure.ControlledVocabularyEntry-entryValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-entryValue" xmi:type="uml:Property">
               <ownedComment xmi:id="CDIFDataStructure.ControlledVocabularyEntry-entryValue-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-entryValue-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.ControlledVocabularyEntry-entryValue"/>
                  <body>The value of the entry of the controlled vocabulary. If no controlled vocabulary is used the term is entered here and none of the properties defining the controlled vocabulary location are used.</body>
               </ownedComment>
               <lowerValue xmi:id="CDIFDataStructure.ControlledVocabularyEntry-entryValue-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-entryValue-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="CDIFDataStructure.ControlledVocabularyEntry-entryValue-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-entryValue-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                  <value>*</value>
               </upperValue>
               <name>entryValue</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="CDIFDataStructure.ControlledVocabularyEntry-name" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-name" xmi:type="uml:Property">
               <ownedComment xmi:id="CDIFDataStructure.ControlledVocabularyEntry-name-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-name-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.ControlledVocabularyEntry-name"/>
                  <body>The name of the code list (controlled vocabulary).</body>
               </ownedComment>
               <lowerValue xmi:id="CDIFDataStructure.ControlledVocabularyEntry-name-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-name-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="CDIFDataStructure.ControlledVocabularyEntry-name-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-name-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>name</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="CDIFDataStructure.ControlledVocabularyEntry-valueForOther" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-valueForOther" xmi:type="uml:Property">
               <ownedComment xmi:id="CDIFDataStructure.ControlledVocabularyEntry-valueForOther-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-valueForOther-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.ControlledVocabularyEntry-valueForOther"/>
                  <body>If the value of the string is "Other" or the equivalent from the codelist, this attribute can provide a more specific value not found in the codelist.</body>
               </ownedComment>
               <lowerValue xmi:id="CDIFDataStructure.ControlledVocabularyEntry-valueForOther-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-valueForOther-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="CDIFDataStructure.ControlledVocabularyEntry-valueForOther-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-valueForOther-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>valueForOther</name>
               <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="CDIFDataStructure.ControlledVocabularyEntry-vocabulary" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-vocabulary" xmi:type="uml:Property">
               <ownedComment xmi:id="CDIFDataStructure.ControlledVocabularyEntry-vocabulary-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-vocabulary-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.ControlledVocabularyEntry-vocabulary"/>
                  <body>A reference to the external controlled vocabulary, using a URI or other resolvable identifier.</body>
               </ownedComment>
               <lowerValue xmi:id="CDIFDataStructure.ControlledVocabularyEntry-vocabulary-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-vocabulary-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="CDIFDataStructure.ControlledVocabularyEntry-vocabulary-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ControlledVocabularyEntry-vocabulary-upperValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </upperValue>
               <name>vocabulary</name>
               <type xmi:idref="CDIFDataStructure.Reference"/>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:id="CDIFDataStructure.InternationalString" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InternationalString" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFDataStructure.InternationalString-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InternationalString-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.InternationalString"/>
               <body>Packaging structure for multilingual versions of the same string content, represented by a set of LanguageString. Only one LanguageString per language/scope type is allowed. Where an element of this type (InternationalString) is repeatable, the expectation is that each repetition contains a different content, each of which can be expressed in multiple languages.</body>
            </ownedComment>
            <name>InternationalString</name>
            <ownedAttribute xmi:id="CDIFDataStructure.InternationalString-languageSpecificString" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InternationalString-languageSpecificString" xmi:type="uml:Property">
               <ownedComment xmi:id="CDIFDataStructure.InternationalString-languageSpecificString-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InternationalString-languageSpecificString-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.InternationalString-languageSpecificString"/>
                  <body>A non-formatted string of text with an attribute that designates the language of the text. Repeat this object to express the same content in another language.</body>
               </ownedComment>
               <lowerValue xmi:id="CDIFDataStructure.InternationalString-languageSpecificString-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InternationalString-languageSpecificString-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="CDIFDataStructure.InternationalString-languageSpecificString-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InternationalString-languageSpecificString-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                  <value>*</value>
               </upperValue>
               <name>languageSpecificString</name>
               <type xmi:idref="CDIFDataStructure.LanguageString"/>
            </ownedAttribute>
         </packagedElement>
         <packagedElement xmi:id="CDIFDataStructure.CatalogDetails" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogDetails" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFDataStructure.CatalogDetails-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogDetails-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.CatalogDetails"/>
               <body>A set of information useful for attribution, data discovery, and access.</body>
            </ownedComment>
            <name>CatalogDetails</name>
            <ownedAttribute xmi:id="CDIFDataStructure.CatalogDetails-access" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogDetails-access" xmi:type="uml:Property">
