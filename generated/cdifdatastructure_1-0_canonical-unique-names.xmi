                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.CdifConceptOrTerm-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CdifConceptOrTerm-identifier-lowerValue" xmi:type="uml:LiteralInteger">
