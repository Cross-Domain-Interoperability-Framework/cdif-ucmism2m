      </packagedElement>
      <packagedElement xmi:id="CDIFDataStructure.CDIFDataStructurePackage" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CDIFDataStructure-package" xmi:type="uml:Package">
         <ownedComment xmi:id="CDIFDataStructure.CDIFDataStructurePackage-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CDIFDataStructure-package-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFDataStructure.CDIFDataStructurePackage"/>
            <body>Data structure description extension classes added by this profile.</body>
         </ownedComment>
         <name>CDIFDataStructure</name>
         <packagedElement xmi:id="CDIFDataStructure.XsdAnyUri" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#XsdAnyUri" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFDataStructure.XsdAnyUri-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#XsdAnyUri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.XsdAnyUri"/>
               <body>Primitive data type "anyURI" of the XML Schema data types.

Definition from XML Schema Part 2: Datatypes Second Edition: "anyURI" represents a Uniform Resource Identifier Reference (URI). An "anyURI" value can be absolute or relative, and may have an optional fragment identifier (i.e., it may be a URI Reference). This type should be used to specify the intention that the value fulfills the role of a URI as defined by [RFC 2396], as amended by [RFC 2732]. For details see https://www.w3.org/TR/xmlschema-2/#anyURI.</body>
            </ownedComment>
            <name>XsdAnyUri</name>
         </packagedElement>
         <packagedElement xmi:id="CDIFDataStructure.Classes" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Classes-package" xmi:type="uml:Package">
            <ownedComment xmi:id="CDIFDataStructure.Classes-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Classes-package-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.Classes"/>
               <body>Target classes of the CDIF profile.</body>
            </ownedComment>
            <name>Classes</name>
            <packagedElement xmi:id="CDIFDataStructure.DataDownload" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDataStructure.DataDownload-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.DataDownload"/>
                  <body>Stub of CDIFCore::DataDownload. The data-structure profile adds the cdi:isStructuredBy property on each schema:distribution DataDownload item.</body>
               </ownedComment>
               <name>DataDownload</name>
               <ownedAttribute xmi:id="CDIFDataStructure.DataDownload-identifier" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-identifier" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.DataDownload-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.DataDownload-identifier"/>
                     <body>@id - resolvable URI for the download.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.DataDownload-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.DataDownload-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFDataStructure.XsdAnyUri"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.DataDownload-subjectOf" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-subjectOf" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.DataDownload-subjectOf-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-subjectOf-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.DataDownload-subjectOf"/>
                     <body>schema:subjectOf - the catalog record describing this dataset's metadata. For the data-structure profile, the CatalogRecord MUST declare conformance to https://w3id.org/cdif/data_structure/1.0.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.DataDownload-subjectOf-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-subjectOf-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.DataDownload-subjectOf-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-subjectOf-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>subjectOf</name>
                  <type xmi:idref="CDIFDataStructure.CatalogRecord"/>
                  <association xmi:idref="CDIFDataStructure.DataDownload_subjectOf_CatalogRecord"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.DataDownload-isStructuredBy" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.DataDownload-isStructuredBy"/>
                     <body>cdi:isStructuredBy - the reusable data-structure description for this distribution. One of DataStructure / DimensionalDataStructure / LongDataStructure / WideDataStructure (or @id-reference to one declared elsewhere).</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>isStructuredBy</name>
                  <type xmi:idref="CDIFDataStructure.AbstractDataStructure"/>
                  <association xmi:idref="CDIFDataStructure.DataDownload_isStructuredBy_AbstractDataStructure"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFDataStructure.CatalogRecord" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogRecord" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDataStructure.CatalogRecord-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogRecord-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.CatalogRecord"/>
                  <body>Stub of CDIFCore::CatalogRecord. For the data-structure profile, dcterms:conformsTo MUST include https://w3id.org/cdif/data_structure/1.0.</body>
               </ownedComment>
               <name>CatalogRecord</name>
               <ownedAttribute xmi:id="CDIFDataStructure.CatalogRecord-conformsTo" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogRecord-conformsTo" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.CatalogRecord-conformsTo-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogRecord-conformsTo-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.CatalogRecord-conformsTo"/>
                     <body>dcterms:conformsTo - MUST include the constant https://w3id.org/cdif/data_structure/1.0 for the data-structure profile.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.CatalogRecord-conformsTo-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogRecord-conformsTo-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.CatalogRecord-conformsTo-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogRecord-conformsTo-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>conformsTo</name>
                  <type xmi:idref="CDIFDataStructure.XsdAnyUri"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFDataStructure.DataStructureComponent" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataStructureComponent" xmi:type="uml:Class" isAbstract="true">
               <ownedComment xmi:id="CDIFDataStructure.DataStructureComponent-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataStructureComponent-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.DataStructureComponent"/>
                  <body>Stub of cdifDataType::cdifDataStructureComponent (abstract). Subtypes (IdentifierComponent / MeasureComponent / AttributeComponent / DimensionComponent / VariableDescriptorComponent / VariableValueComponent) are defined in that BB.</body>
               </ownedComment>
               <name>DataStructureComponent</name>
               <ownedAttribute xmi:id="CDIFDataStructure.DataStructureComponent-identifier" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataStructureComponent-identifier" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.DataStructureComponent-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataStructureComponent-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.DataStructureComponent-identifier"/>
                     <body>@id - resolvable URI for the component.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.DataStructureComponent-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataStructureComponent-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.DataStructureComponent-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataStructureComponent-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFDataStructure.XsdAnyUri"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFDataStructure.InstanceVariable" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InstanceVariable" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDataStructure.InstanceVariable-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InstanceVariable-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.InstanceVariable"/>
                  <body>Stub of CDIFDataDescription::InstanceVariable. Referenced by PrimaryKey.isComposedOf - the ordered list of variables that uniquely identify each row.</body>
               </ownedComment>
               <name>InstanceVariable</name>
               <ownedAttribute xmi:id="CDIFDataStructure.InstanceVariable-identifier" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InstanceVariable-identifier" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.InstanceVariable-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InstanceVariable-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.InstanceVariable-identifier"/>
                     <body>@id - resolvable URI for the variable.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.InstanceVariable-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InstanceVariable-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.InstanceVariable-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InstanceVariable-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFDataStructure.XsdAnyUri"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFDataStructure.AbstractDataStructure" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AbstractDataStructure" xmi:type="uml:Class" isAbstract="true">
               <ownedComment xmi:id="CDIFDataStructure.AbstractDataStructure-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AbstractDataStructure-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.AbstractDataStructure"/>
                  <body>Abstract supertype for the four DataStructure variants. cdi:isStructuredBy on a DataDownload accepts any concrete subtype: DataStructure (general), DimensionalDataStructure (cube), LongDataStructure (variable-value-pair rows), WideDataStructure (wide-format tables).</body>
               </ownedComment>
               <name>AbstractDataStructure</name>
               <ownedAttribute xmi:id="CDIFDataStructure.AbstractDataStructure-identifier" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AbstractDataStructure-identifier" xmi:type="uml:Property">
