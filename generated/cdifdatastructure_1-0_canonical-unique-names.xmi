<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CDIFDataStructure.CDIFDataStructure" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CDIFDataStructure">
      <ownedComment xmi:id="CDIFDataStructure.CDIFDataStructure-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CDIFDataStructure-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFDataStructure.CDIFDataStructure"/>
         <body>CDIF Data Structure profile module - adds cdi:isStructuredBy on a DataDownload, pointing at one of four AbstractDataStructure variants (DataStructure / DimensionalDataStructure / LongDataStructure / WideDataStructure). Each structure has DataStructureComponents and optional PrimaryKey / ForeignKey. The catalog record (schema:subjectOf &gt; CatalogRecord) MUST declare conformance to https://w3id.org/cdif/data_structure/1.0.</body>
      </ownedComment>
      <name>CDIFDataStructure</name>
      <URI>https://w3id.org/cdif/data_structure/1.0/xmi/</URI>
      <packagedElement xmi:id="CDIFDataStructure.ModelIdentification" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification" xmi:type="uml:DataType">
         <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-prefix-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-prefix"/>
               <body>Namespace prefix of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataStructure.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>prefix</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-prefix-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix-defaultValue" xmi:type="uml:LiteralString">
               <value>cdif</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-majorVersion" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-majorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-majorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-majorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-majorVersion"/>
