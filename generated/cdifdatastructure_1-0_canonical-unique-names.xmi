                  <upperValue xmi:id="CDIFDataStructure.InstanceVariable-takesSubstantiveValuesFrom-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InstanceVariable-takesSubstantiveValuesFrom-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>takesSubstantiveValuesFrom</name>
                  <type xmi:idref="CDIFDataStructure.SubstantiveValueDomain"/>
                  <association xmi:idref="CDIFDataStructure.InstanceVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.InstanceVariable-takesSentinelValuesFrom" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InstanceVariable-takesSentinelValuesFrom" xmi:type="uml:Property">
