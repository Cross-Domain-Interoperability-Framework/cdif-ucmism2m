                     <annotatedElement xmi:idref="CDIFDataStructure.TabularTextDataSet-fileSizeUofM"/>
                     <body>Unit of measure of the fileSize as a simple string, e.g. KB, megabyte, GB, etc.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.TabularTextDataSet-fileSizeUofM-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#TabularTextDataSet-fileSizeUofM-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.TabularTextDataSet-fileSizeUofM-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#TabularTextDataSet-fileSizeUofM-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
