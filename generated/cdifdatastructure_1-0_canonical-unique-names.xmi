                  <lowerValue xmi:id="CDIFDataStructure.RepresentedVariable-takesSentinelValuesFrom-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#RepresentedVariable-takesSentinelValuesFrom-lowerValue" xmi:type="uml:LiteralInteger">
