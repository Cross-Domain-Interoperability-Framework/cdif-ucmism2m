               </ownedComment>
               <lowerValue xmi:id="CDIFDataStructure.ProvenanceInformation-funding-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ProvenanceInformation-funding-lowerValue" xmi:type="uml:LiteralInteger">
                  <value>1</value>
               </lowerValue>
               <upperValue xmi:id="CDIFDataStructure.ProvenanceInformation-funding-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ProvenanceInformation-funding-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                  <value>*</value>
               </upperValue>
               <name>funding</name>
               <type xmi:idref="CDIFDataStructure.FundingInformation"/>
