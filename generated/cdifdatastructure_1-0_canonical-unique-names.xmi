                  <ownedComment xmi:id="CDIFDataStructure.SubstantiveValueDomain-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#SubstantiveValueDomain-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.SubstantiveValueDomain-identifier"/>
