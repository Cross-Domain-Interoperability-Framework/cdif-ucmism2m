            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>language</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-language-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-language-defaultValue" xmi:type="uml:LiteralString">
