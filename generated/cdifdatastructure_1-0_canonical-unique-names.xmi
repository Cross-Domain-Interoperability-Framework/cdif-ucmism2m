                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.InstanceVariable-unitOfMeasureKind-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InstanceVariable-unitOfMeasureKind-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
