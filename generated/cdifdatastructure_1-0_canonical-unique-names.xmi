               <lowerValue xmi:id="CDIFDataStructure.AgentInRole-reference-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AgentInRole-reference-lowerValue" xmi:type="uml:LiteralInteger">
