                  <ownedComment xmi:id="CDIFDataStructure.ConceptSystem-allowsDuplicates-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ConceptSystem-allowsDuplicates-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.ConceptSystem-allowsDuplicates"/>
                     <body>If value is False, the members are unique within the collection - if True, there may be duplicates. (Note that a mathematical “bag” permits duplicates and is unordered - a “set” does not have duplicates and may be ordered.)</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.ConceptSystem-allowsDuplicates-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ConceptSystem-allowsDuplicates-lowerValue" xmi:type="uml:LiteralInteger">
