               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.RepresentedVariable-takesSentinelConceptsFrom" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#RepresentedVariable-takesSentinelConceptsFrom" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.RepresentedVariable-takesSentinelConceptsFrom-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#RepresentedVariable-takesSentinelConceptsFrom-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.RepresentedVariable-takesSentinelConceptsFrom"/>
                     <body>cdi:takesSentinelConceptsFrom - the sentinel conceptual domain for this represented variable.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.RepresentedVariable-takesSentinelConceptsFrom-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#RepresentedVariable-takesSentinelConceptsFrom-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.RepresentedVariable-takesSentinelConceptsFrom-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#RepresentedVariable-takesSentinelConceptsFrom-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>takesSentinelConceptsFrom</name>
