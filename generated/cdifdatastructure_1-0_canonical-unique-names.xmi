                  <type xmi:idref="CDIFDataStructure.Concept"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.StructuredDataSet-fileSize" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#StructuredDataSet-fileSize" xmi:type="uml:Property">
