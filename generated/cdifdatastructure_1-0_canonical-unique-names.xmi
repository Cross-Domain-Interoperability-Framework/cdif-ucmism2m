                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.TabularTextDataSet-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#TabularTextDataSet-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFDataStructure.Identifier"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.TabularTextDataSet-name" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#TabularTextDataSet-name" xmi:type="uml:Property">
