               <ownedAttribute xmi:id="CDIFDataStructure.SubstantiveValueDomain-recommendedDataType" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#SubstantiveValueDomain-recommendedDataType" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.SubstantiveValueDomain-recommendedDataType-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#SubstantiveValueDomain-recommendedDataType-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.SubstantiveValueDomain-recommendedDataType"/>
