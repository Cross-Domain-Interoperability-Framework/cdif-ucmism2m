            <packagedElement xmi:id="CDIFDataStructure.PrimaryKeyComponent" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PrimaryKeyComponent" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDataStructure.PrimaryKeyComponent-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PrimaryKeyComponent-ownedComment" xmi:type="uml:Comment">
