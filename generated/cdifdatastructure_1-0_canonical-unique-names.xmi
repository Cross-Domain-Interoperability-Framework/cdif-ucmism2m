               <ownedAttribute xmi:id="CDIFDataStructure.RepresentedVariable-measures" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#RepresentedVariable-measures" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.RepresentedVariable-measures-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#RepresentedVariable-measures-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.RepresentedVariable-measures"/>
                     <body>cdi:measures - the UnitType this represented variable measures.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.RepresentedVariable-measures-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#RepresentedVariable-measures-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.RepresentedVariable-measures-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#RepresentedVariable-measures-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>measures</name>
                  <type xmi:idref="CDIFDataStructure.UnitType"/>
                  <association xmi:idref="CDIFDataStructure.RepresentedVariable_measures_UnitType"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.RepresentedVariable-takesSubstantiveConceptsFrom" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#RepresentedVariable-takesSubstantiveConceptsFrom" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.RepresentedVariable-takesSubstantiveConceptsFrom-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#RepresentedVariable-takesSubstantiveConceptsFrom-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.RepresentedVariable-takesSubstantiveConceptsFrom"/>
                     <body>cdi:takesSubstantiveConceptsFrom - the substantive conceptual domain for this represented variable.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.RepresentedVariable-takesSubstantiveConceptsFrom-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#RepresentedVariable-takesSubstantiveConceptsFrom-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.RepresentedVariable-takesSubstantiveConceptsFrom-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#RepresentedVariable-takesSubstantiveConceptsFrom-upperValue" xmi:type="uml:LiteralInteger">
