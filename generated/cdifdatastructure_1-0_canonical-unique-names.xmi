               <ownedAttribute xmi:id="CDIFDataStructure.SubstantiveValueDomain-takesValuesFrom" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#SubstantiveValueDomain-takesValuesFrom" xmi:type="uml:Property">
