                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.DescriptorVariable-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DescriptorVariable-identifier-lowerValue" xmi:type="uml:LiteralInteger">
