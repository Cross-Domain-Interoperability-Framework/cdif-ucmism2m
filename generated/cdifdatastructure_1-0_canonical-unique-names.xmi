                  <lowerValue xmi:id="CDIFDataStructure.InstanceVariable-takesSubstantiveValuesFrom-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#InstanceVariable-takesSubstantiveValuesFrom-lowerValue" xmi:type="uml:LiteralInteger">
