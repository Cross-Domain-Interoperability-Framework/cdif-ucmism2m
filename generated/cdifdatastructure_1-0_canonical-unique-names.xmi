                     <annotatedElement xmi:idref="CDIFDataStructure.PrimaryKey-isComposedOf"/>
                     <body>cdif:isComposedOf - the RepresentedVariables that make up the key. Each item is a {RepresentedVariable (inline or @id-reference), cdif:position (positive integer)} pair; the position is the 1-based position of the component in the key.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.PrimaryKey-isComposedOf-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#PrimaryKey-isComposedOf-lowerValue" xmi:type="uml:LiteralInteger">
