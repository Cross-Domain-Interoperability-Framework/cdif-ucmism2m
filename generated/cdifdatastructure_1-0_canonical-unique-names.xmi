               <ownedComment xmi:id="CDIFDataStructure.StructuredDataSet-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#StructuredDataSet-ownedComment" xmi:type="uml:Comment">
