            <ownedAttribute xmi:id="CDIFDataStructure.AccessInformation-rights" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AccessInformation-rights" xmi:type="uml:Property">
               <ownedComment xmi:id="CDIFDataStructure.AccessInformation-rights-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#AccessInformation-rights-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.AccessInformation-rights"/>
