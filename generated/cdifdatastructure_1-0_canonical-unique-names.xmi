                  <lowerValue xmi:id="CDIFDataStructure.SubstantiveValueDomain-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#SubstantiveValueDomain-identifier-lowerValue" xmi:type="uml:LiteralInteger">
