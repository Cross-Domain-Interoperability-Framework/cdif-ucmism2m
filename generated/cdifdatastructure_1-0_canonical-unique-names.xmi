            <packagedElement xmi:id="CDIFDataStructure.SubstantiveValueDomain" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#SubstantiveValueDomain" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDataStructure.SubstantiveValueDomain-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#SubstantiveValueDomain-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.SubstantiveValueDomain"/>
