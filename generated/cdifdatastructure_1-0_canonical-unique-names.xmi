<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CDIFDataStructure.CDIFDataStructure" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CDIFDataStructure">
      <ownedComment xmi:id="CDIFDataStructure.CDIFDataStructure-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CDIFDataStructure-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFDataStructure.CDIFDataStructure"/>
         <body>CDIF Data Structure profile module. Adds cdi:isStructuredBy on a DataDownload, pointing at one of four DataStructure variants - DataStructure (general; any component subtype), DimensionalDataStructure (Identifier/Measure/Attribute/Dimension components), LongDataStructure (Identifier/VariableDescriptor/VariableValue/Attribute components), WideDataStructure (Identifier/Measure/Attribute components). Each structure may also carry a PrimaryKey and ForeignKeys. The catalog record (schema:subjectOf &gt; CatalogRecord) MUST declare conformance to https://w3id.org/cdif/data_structure/1.0.</body>
      </ownedComment>
      <name>CDIFDataStructure</name>
      <URI>https://w3id.org/cdif/data_structure/1.0/xmi/</URI>
      <packagedElement xmi:id="CDIFDataStructure.ModelIdentification" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification" xmi:type="uml:DataType">
         <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-prefix-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-prefix"/>
               <body>Namespace prefix of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataStructure.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>prefix</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-prefix-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-prefix-defaultValue" xmi:type="uml:LiteralString">
               <value>cdif</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-majorVersion" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-majorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-majorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-majorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-majorVersion"/>
               <body>Major version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataStructure.ModelIdentification-majorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-majorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-majorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-majorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>majorVersion</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-majorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-majorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-minorVersion" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-minorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-minorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-minorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-minorVersion"/>
               <body>Minor version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataStructure.ModelIdentification-minorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-minorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-minorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-minorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>minorVersion</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-minorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-minorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>0</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-title" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-title" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-title"/>
               <body>Title of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataStructure.ModelIdentification-title-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-title-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>title</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-title-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-title-defaultValue" xmi:type="uml:LiteralString">
               <value>UML Model for the CDIF Data Structure Profile</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-language" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-language" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-language-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-language-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-language"/>
               <body>Primary language of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataStructure.ModelIdentification-language-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-language-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>language</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-language-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-language-defaultValue" xmi:type="uml:LiteralString">
               <value>en</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDataStructure.ModelIdentification-uri" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-uri" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDataStructure.ModelIdentification-uri-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-uri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.ModelIdentification-uri"/>
               <body>Namespace URI of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDataStructure.ModelIdentification-uri-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-uri-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDataStructure.ModelIdentification-uri-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-uri-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>uri</name>
            <defaultValue xmi:id="CDIFDataStructure.ModelIdentification-uri-defaultValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#ModelIdentification-uri-defaultValue" xmi:type="uml:LiteralString">
               <value>https://w3id.org/cdif/data_structure/1.0/xmi/</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:id="CDIFDataStructure.CDIFDataStructurePackage" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CDIFDataStructure-package" xmi:type="uml:Package">
         <ownedComment xmi:id="CDIFDataStructure.CDIFDataStructurePackage-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CDIFDataStructure-package-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFDataStructure.CDIFDataStructurePackage"/>
            <body>Data structure description extension classes added by this profile.</body>
         </ownedComment>
         <name>CDIFDataStructure</name>
         <packagedElement xmi:id="CDIFDataStructure.XsdAnyUri" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#XsdAnyUri" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFDataStructure.XsdAnyUri-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#XsdAnyUri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.XsdAnyUri"/>
               <body>Primitive data type "anyURI" of the XML Schema data types.

Definition from XML Schema Part 2: Datatypes Second Edition: "anyURI" represents a Uniform Resource Identifier Reference (URI). An "anyURI" value can be absolute or relative, and may have an optional fragment identifier (i.e., it may be a URI Reference). This type should be used to specify the intention that the value fulfills the role of a URI as defined by [RFC 2396], as amended by [RFC 2732]. For details see https://www.w3.org/TR/xmlschema-2/#anyURI.</body>
            </ownedComment>
            <name>XsdAnyUri</name>
         </packagedElement>
         <packagedElement xmi:id="CDIFDataStructure.Classes" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Classes-package" xmi:type="uml:Package">
            <ownedComment xmi:id="CDIFDataStructure.Classes-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#Classes-package-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDataStructure.Classes"/>
               <body>Target classes of the CDIF profile.</body>
            </ownedComment>
            <name>Classes</name>
            <packagedElement xmi:id="CDIFDataStructure.DataDownload" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDataStructure.DataDownload-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.DataDownload"/>
                  <body>Stub of CDIFCore::DataDownload. The data-structure profile adds the cdi:isStructuredBy property on each schema:distribution DataDownload item, pointing at one of the four DataStructure variants.</body>
               </ownedComment>
               <name>DataDownload</name>
               <ownedAttribute xmi:id="CDIFDataStructure.DataDownload-identifier" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-identifier" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.DataDownload-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.DataDownload-identifier"/>
                     <body>@id - resolvable URI for the download.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.DataDownload-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.DataDownload-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFDataStructure.XsdAnyUri"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.DataDownload-subjectOf" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-subjectOf" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.DataDownload-subjectOf-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-subjectOf-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.DataDownload-subjectOf"/>
                     <body>schema:subjectOf - the catalog record describing this dataset's metadata. MUST declare conformance to https://w3id.org/cdif/data_structure/1.0.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.DataDownload-subjectOf-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-subjectOf-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.DataDownload-subjectOf-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-subjectOf-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>subjectOf</name>
                  <type xmi:idref="CDIFDataStructure.CatalogRecord"/>
                  <association xmi:idref="CDIFDataStructure.DataDownload_subjectOf_CatalogRecord"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.DataDownload-isStructuredBy" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.DataDownload-isStructuredBy"/>
                     <body>cdi:isStructuredBy - general DataStructure variant. Accepts any component subtype.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>isStructuredBy</name>
                  <type xmi:idref="CDIFDataStructure.DataStructure"/>
                  <association xmi:idref="CDIFDataStructure.DataDownload_isStructuredBy_DataStructure"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.DataDownload-isStructuredBy" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.DataDownload-isStructuredBy"/>
                     <body>cdi:isStructuredBy - dimensional (cube) variant. Components restricted to Identifier / Measure / Attribute / Dimension.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>isStructuredBy</name>
                  <type xmi:idref="CDIFDataStructure.DimensionalDataStructure"/>
                  <association xmi:idref="CDIFDataStructure.DataDownload_isStructuredBy_DimensionalDataStructure"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.DataDownload-isStructuredBy" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.DataDownload-isStructuredBy"/>
                     <body>cdi:isStructuredBy - long (narrow) variant. Required: exactly one Identifier + VariableDescriptor + VariableValue; optional Attribute.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>isStructuredBy</name>
                  <type xmi:idref="CDIFDataStructure.LongDataStructure"/>
                  <association xmi:idref="CDIFDataStructure.DataDownload_isStructuredBy_LongDataStructure"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDataStructure.DataDownload-isStructuredBy" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.DataDownload-isStructuredBy"/>
                     <body>cdi:isStructuredBy - wide (tabular) variant. Components restricted to Identifier / Measure / Attribute.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.DataDownload-isStructuredBy-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#DataDownload-isStructuredBy-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>isStructuredBy</name>
                  <type xmi:idref="CDIFDataStructure.WideDataStructure"/>
                  <association xmi:idref="CDIFDataStructure.DataDownload_isStructuredBy_WideDataStructure"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFDataStructure.CatalogRecord" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogRecord" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDataStructure.CatalogRecord-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogRecord-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDataStructure.CatalogRecord"/>
                  <body>Stub of CDIFCore::CatalogRecord. For the data-structure profile, dcterms:conformsTo MUST include https://w3id.org/cdif/data_structure/1.0.</body>
               </ownedComment>
               <name>CatalogRecord</name>
               <ownedAttribute xmi:id="CDIFDataStructure.CatalogRecord-conformsTo" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogRecord-conformsTo" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.CatalogRecord-conformsTo-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogRecord-conformsTo-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.CatalogRecord-conformsTo"/>
                     <body>dcterms:conformsTo - MUST include the constant https://w3id.org/cdif/data_structure/1.0 for the data-structure profile.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDataStructure.CatalogRecord-conformsTo-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogRecord-conformsTo-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDataStructure.CatalogRecord-conformsTo-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#CatalogRecord-conformsTo-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
