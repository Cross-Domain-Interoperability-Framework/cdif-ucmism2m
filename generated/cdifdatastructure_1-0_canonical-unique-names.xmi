               </ownedComment>
               <name>SubstantiveValueDomain</name>
               <ownedAttribute xmi:id="CDIFDataStructure.SubstantiveValueDomain-displayLabel" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#SubstantiveValueDomain-displayLabel" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDataStructure.SubstantiveValueDomain-displayLabel-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.0/xmi/#SubstantiveValueDomain-displayLabel-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDataStructure.SubstantiveValueDomain-displayLabel"/>
                     <body>A human-readable display label for the object. Supports the use of multiple languages. Repeat for labels with different content, for example, labels with differing length limitations.</body>
