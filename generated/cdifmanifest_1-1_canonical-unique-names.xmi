<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CDIFManifest.CDIFManifest" xmi:uuid="https://w3id.org/cdif/manifest/1.1/xmi/#CDIFManifest">
      <ownedComment xmi:id="CDIFManifest.CDIFManifest-ownedComment" xmi:uuid="https://w3id.org/cdif/manifest/1.1/xmi/#CDIFManifest-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFManifest.CDIFManifest"/>
         <body>CDIF Archive Distribution profile module. On any Dataset whose catalog record declares conformance to https://w3id.org/cdif/manifest/1.1, schema:distribution items that are schema:DataDownloads MAY carry schema:hasPart describing the component files inside an archive. Each ArchivePart can itself carry cdif:hasPhysicalMapping and the cdi: physical-dataset co-typing (TabularTextDataSet / StructuredDataSet) when it is a tabular or structured data file.</body>
      </ownedComment>
      <name>CDIFManifest</name>
      <URI>https://w3id.org/cdif/manifest/1.1/xmi/</URI>
