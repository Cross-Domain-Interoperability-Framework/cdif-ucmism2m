<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CDIFArchive.CDIFArchive" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#CDIFArchive">
      <ownedComment xmi:id="CDIFArchive.CDIFArchive-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#CDIFArchive-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFArchive.CDIFArchive"/>
         <body>CDIF Archive profile module - documents the archive-distribution pattern: a schema:DataDownload whose schema:hasPart enumerates component files (schema:MediaObject items) inside the archive (e.g. ZIP). Each ArchivePart records filename, MIME type(s), size, optional spdx:checksum, optional schema:about back-reference, and may carry data-description extensions (cdifTabularData, cdifDataCube). The composite cdifComplete profile pulls this module in. Conforms-to identifier: https://w3id.org/cdif/manifest/1.0.</body>
      </ownedComment>
      <name>CDIFArchive</name>
      <URI>https://w3id.org/cdif/archive/1.0/xmi/</URI>
      <packagedElement xmi:id="CDIFArchive.ModelIdentification" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification" xmi:type="uml:DataType">
         <ownedComment xmi:id="CDIFArchive.ModelIdentification-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFArchive.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="CDIFArchive.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFArchive.ModelIdentification-prefix-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-prefix-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFArchive.ModelIdentification-prefix"/>
               <body>Namespace prefix of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFArchive.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFArchive.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>prefix</name>
            <defaultValue xmi:id="CDIFArchive.ModelIdentification-prefix-defaultValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-prefix-defaultValue" xmi:type="uml:LiteralString">
               <value>cdif</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFArchive.ModelIdentification-majorVersion" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-majorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFArchive.ModelIdentification-majorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-majorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFArchive.ModelIdentification-majorVersion"/>
               <body>Major version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFArchive.ModelIdentification-majorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-majorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFArchive.ModelIdentification-majorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-majorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>majorVersion</name>
            <defaultValue xmi:id="CDIFArchive.ModelIdentification-majorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-majorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFArchive.ModelIdentification-minorVersion" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-minorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFArchive.ModelIdentification-minorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-minorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFArchive.ModelIdentification-minorVersion"/>
               <body>Minor version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFArchive.ModelIdentification-minorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-minorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFArchive.ModelIdentification-minorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-minorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>minorVersion</name>
            <defaultValue xmi:id="CDIFArchive.ModelIdentification-minorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-minorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>0</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFArchive.ModelIdentification-title" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-title" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFArchive.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFArchive.ModelIdentification-title"/>
               <body>Title of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFArchive.ModelIdentification-title-lowerValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-title-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFArchive.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>title</name>
            <defaultValue xmi:id="CDIFArchive.ModelIdentification-title-defaultValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-title-defaultValue" xmi:type="uml:LiteralString">
               <value>UML Model for the CDIF Archive Profile</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFArchive.ModelIdentification-language" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-language" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFArchive.ModelIdentification-language-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-language-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFArchive.ModelIdentification-language"/>
               <body>Primary language of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFArchive.ModelIdentification-language-lowerValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-language-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFArchive.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>language</name>
            <defaultValue xmi:id="CDIFArchive.ModelIdentification-language-defaultValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-language-defaultValue" xmi:type="uml:LiteralString">
               <value>en</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFArchive.ModelIdentification-uri" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-uri" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFArchive.ModelIdentification-uri-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-uri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFArchive.ModelIdentification-uri"/>
               <body>Namespace URI of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFArchive.ModelIdentification-uri-lowerValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-uri-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFArchive.ModelIdentification-uri-upperValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-uri-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>uri</name>
            <defaultValue xmi:id="CDIFArchive.ModelIdentification-uri-defaultValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ModelIdentification-uri-defaultValue" xmi:type="uml:LiteralString">
               <value>https://w3id.org/cdif/archive/1.0/xmi/</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:id="CDIFArchive.CDIFArchivePackage" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#CDIFArchive-package" xmi:type="uml:Package">
         <ownedComment xmi:id="CDIFArchive.CDIFArchivePackage-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#CDIFArchive-package-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFArchive.CDIFArchivePackage"/>
            <body>Archive distribution structure: bundling component files inside a single download.</body>
         </ownedComment>
         <name>CDIFArchive</name>
         <packagedElement xmi:id="CDIFArchive.XsdAnyUri" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#XsdAnyUri" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFArchive.XsdAnyUri-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#XsdAnyUri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFArchive.XsdAnyUri"/>
               <body>Primitive data type "anyURI" of the XML Schema data types.

Definition from XML Schema Part 2: Datatypes Second Edition: "anyURI" represents a Uniform Resource Identifier Reference (URI). An "anyURI" value can be absolute or relative, and may have an optional fragment identifier (i.e., it may be a URI Reference). This type should be used to specify the intention that the value fulfills the role of a URI as defined by [RFC 2396], as amended by [RFC 2732]. For details see https://www.w3.org/TR/xmlschema-2/#anyURI.</body>
            </ownedComment>
            <name>XsdAnyUri</name>
         </packagedElement>
         <packagedElement xmi:id="CDIFArchive.XsdLanguage" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#XsdLanguage" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFArchive.XsdLanguage-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#XsdLanguage-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFArchive.XsdLanguage"/>
               <body>Derived data type "language" of the XML Schema data types.

Definition from XML Schema Part 2: Datatypes Second Edition: "language" represents natural language identifiers as defined by by [RFC 3066]. The value space of "language" is the set of all strings that are valid language identifiers as defined [RFC 3066] . The lexical space of language is the set of all strings that conform to the pattern [a-zA-Z]{1,8}(-[a-zA-Z0-9]{1,8})*. The base type of "language" is token. https://www.w3.org/TR/xmlschema-2/#language.</body>
            </ownedComment>
            <name>XsdLanguage</name>
         </packagedElement>
         <packagedElement xmi:id="CDIFArchive.XsdDate" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#XsdDate" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFArchive.XsdDate-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#XsdDate-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFArchive.XsdDate"/>
               <body>Primitive data type "date" of the XML Schema data types.

Definition from XML Schema Part 2: Datatypes Second Edition: "The value space of date consists of top-open intervals of exactly one day in length on the timelines of dateTime, beginning on the beginning moment of each day (in each timezone), i.e. '00:00:00', up to but not including '24:00:00' (which is identical with '00:00:00' of the next day). For nontimezoned values, the top-open intervals disjointly cover the nontimezoned timeline, one per day. For timezoned values, the intervals begin at every minute and therefore overlap." For details see https://www.w3.org/TR/xmlschema-2/#date.</body>
            </ownedComment>
            <name>XsdDate</name>
         </packagedElement>
         <packagedElement xmi:id="CDIFArchive.Classes" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#Classes-package" xmi:type="uml:Package">
            <ownedComment xmi:id="CDIFArchive.Classes-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#Classes-package-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFArchive.Classes"/>
               <body>Target classes of the CDIF profile.</body>
            </ownedComment>
            <name>Classes</name>
            <packagedElement xmi:id="CDIFArchive.ArchiveDistribution" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchiveDistribution" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFArchive.ArchiveDistribution-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchiveDistribution-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFArchive.ArchiveDistribution"/>
                  <body>A schema:DataDownload distribution that is an archive file (e.g. ZIP, TAR) containing multiple component files described by schema:hasPart. The archive itself is independently accessible (contentUrl); its component files are NOT independently accessible and are typed as schema:MediaObject (not DataDownload). Inherits the standard DataDownload attributes (name, description, contentUrl, contentSize, encodingFormat, conformsTo) from CDIFCore::DataDownload (see that page); this UML restates only the archive-specific surface area.</body>
               </ownedComment>
               <name>ArchiveDistribution</name>
               <ownedAttribute xmi:id="CDIFArchive.ArchiveDistribution-identifier" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchiveDistribution-identifier" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFArchive.ArchiveDistribution-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchiveDistribution-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFArchive.ArchiveDistribution-identifier"/>
                     <body>@id - resolvable URI for the archive distribution itself.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFArchive.ArchiveDistribution-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchiveDistribution-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFArchive.ArchiveDistribution-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchiveDistribution-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFArchive.XsdAnyUri"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFArchive.ArchiveDistribution-hasPart" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchiveDistribution-hasPart" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFArchive.ArchiveDistribution-hasPart-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchiveDistribution-hasPart-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFArchive.ArchiveDistribution-hasPart"/>
                     <body>schema:hasPart - the component files inside this archive distribution.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFArchive.ArchiveDistribution-hasPart-lowerValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchiveDistribution-hasPart-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFArchive.ArchiveDistribution-hasPart-upperValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchiveDistribution-hasPart-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>hasPart</name>
                  <type xmi:idref="CDIFArchive.ArchivePart"/>
                  <association xmi:idref="CDIFArchive.ArchiveDistribution_hasPart_ArchivePart"/>
               </ownedAttribute>
            </packagedElement>
            <packagedElement xmi:id="CDIFArchive.ArchivePart" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFArchive.ArchivePart-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFArchive.ArchivePart"/>
                  <body>A component file within an archive distribution. Typed as schema:MediaObject; carries filename, MIME type(s), optional size and checksum, and optional schema:about back-references when the part is a sidecar metadata file.</body>
               </ownedComment>
               <name>ArchivePart</name>
               <ownedAttribute xmi:id="CDIFArchive.ArchivePart-identifier" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-identifier" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFArchive.ArchivePart-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFArchive.ArchivePart-identifier"/>
                     <body>@id - identifier for this part, typically a hash-anchor (e.g. '#abc123'). Used as the target of schema:about back-references from sidecar metadata files inside the same archive.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFArchive.ArchivePart-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFArchive.ArchivePart-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFArchive.XsdAnyUri"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFArchive.ArchivePart-name" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-name" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFArchive.ArchivePart-name-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-name-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFArchive.ArchivePart-name"/>
                     <body>schema:name - filename of the component file within the archive.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFArchive.ArchivePart-name-lowerValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-name-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFArchive.ArchivePart-name-upperValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-name-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>name</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFArchive.ArchivePart-description" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-description" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFArchive.ArchivePart-description-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-description-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFArchive.ArchivePart-description"/>
                     <body>schema:description - short description of the file content.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFArchive.ArchivePart-description-lowerValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-description-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFArchive.ArchivePart-description-upperValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-description-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>description</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFArchive.ArchivePart-encodingFormat" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-encodingFormat" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFArchive.ArchivePart-encodingFormat-ownedComment" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-encodingFormat-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFArchive.ArchivePart-encodingFormat"/>
                     <body>schema:encodingFormat - MIME type(s) of this file.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFArchive.ArchivePart-encodingFormat-lowerValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-encodingFormat-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFArchive.ArchivePart-encodingFormat-upperValue" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-encodingFormat-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>encodingFormat</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFArchive.ArchivePart-about" xmi:uuid="https://w3id.org/cdif/archive/1.0/xmi/#ArchivePart-about" xmi:type="uml:Property">
