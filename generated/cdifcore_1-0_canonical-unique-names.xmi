                  </ownedComment>
                  <lowerValue xmi:id="CDIFCore.Dataset-description-lowerValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#Dataset-description-lowerValue" xmi:type="uml:LiteralInteger">
