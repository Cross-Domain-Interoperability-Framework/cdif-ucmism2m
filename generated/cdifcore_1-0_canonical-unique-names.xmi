                  <lowerValue xmi:id="CDIFCore.Dataset-inLanguage-lowerValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#Dataset-inLanguage-lowerValue" xmi:type="uml:LiteralInteger">
