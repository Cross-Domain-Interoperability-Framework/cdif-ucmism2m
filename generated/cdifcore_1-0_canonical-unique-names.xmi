<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CDIFCore.CDIFCore" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#CDIFCore">
      <ownedComment xmi:id="CDIFCore.CDIFCore-ownedComment" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#CDIFCore-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFCore.CDIFCore"/>
         <body>CDIF Core profile - the foundational schema.org-based metadata properties applicable to any resource type (default schema:Dataset). Composed by every higher CDIF profile (Discovery, DataDescription, DataStructure, Codelist, complete). Anchors: schema:Dataset (data resource), schema:DataDownload / schema:WebAPI (distributions), schema:Person / schema:Organization (agents), schema:subjectOf -&gt; CdifCatalogRecord (metadata-about-the-metadata), prov:wasGeneratedBy -&gt; prov:Activity, prov:wasDerivedFrom (sources).</body>
      </ownedComment>
      <name>CDIFCore</name>
      <URI>https://w3id.org/cdif/core/1.0/xmi/</URI>
      <packagedElement xmi:id="CDIFCore.ModelIdentification" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification" xmi:type="uml:DataType">
         <ownedComment xmi:id="CDIFCore.ModelIdentification-ownedComment" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFCore.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="CDIFCore.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFCore.ModelIdentification-prefix-ownedComment" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-prefix-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFCore.ModelIdentification-prefix"/>
               <body>Namespace prefix of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFCore.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFCore.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>prefix</name>
            <defaultValue xmi:id="CDIFCore.ModelIdentification-prefix-defaultValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-prefix-defaultValue" xmi:type="uml:LiteralString">
               <value>cdif</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFCore.ModelIdentification-majorVersion" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-majorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFCore.ModelIdentification-majorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-majorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFCore.ModelIdentification-majorVersion"/>
               <body>Major version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFCore.ModelIdentification-majorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-majorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFCore.ModelIdentification-majorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-majorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>majorVersion</name>
            <defaultValue xmi:id="CDIFCore.ModelIdentification-majorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-majorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFCore.ModelIdentification-minorVersion" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-minorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFCore.ModelIdentification-minorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-minorVersion-ownedComment" xmi:type="uml:Comment">
