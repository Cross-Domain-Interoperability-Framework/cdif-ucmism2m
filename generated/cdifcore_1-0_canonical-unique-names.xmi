                  <upperValue xmi:id="CDIFCore.Dataset-inLanguage-upperValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#Dataset-inLanguage-upperValue" xmi:type="uml:LiteralInteger">
