               <ownedAttribute xmi:id="CDIFCore.Dataset-additionalType" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#Dataset-additionalType" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFCore.Dataset-additionalType-ownedComment" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#Dataset-additionalType-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFCore.Dataset-additionalType"/>
                     <body>schema:additionalType - identifiers for datatypes from other vocabularies (URI or DefinedTerm).</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFCore.Dataset-additionalType-lowerValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#Dataset-additionalType-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFCore.Dataset-additionalType-upperValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#Dataset-additionalType-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>additionalType</name>
                  <type xmi:idref="CDIFCore.DefinedTerm"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFCore.Dataset-sameAs" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#Dataset-sameAs" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFCore.Dataset-sameAs-ownedComment" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#Dataset-sameAs-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFCore.Dataset-sameAs"/>
