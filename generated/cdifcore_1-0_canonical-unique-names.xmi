                  </ownedComment>
                  <lowerValue xmi:id="CDIFCore.Dataset-sameAs-lowerValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#Dataset-sameAs-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFCore.Dataset-sameAs-upperValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#Dataset-sameAs-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
