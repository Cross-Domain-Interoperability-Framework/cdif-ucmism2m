            </ownedComment>
            <lowerValue xmi:id="CDIFCore.ModelIdentification-minorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-minorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFCore.ModelIdentification-minorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-minorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>minorVersion</name>
            <defaultValue xmi:id="CDIFCore.ModelIdentification-minorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-minorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>0</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFCore.ModelIdentification-title" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-title" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFCore.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFCore.ModelIdentification-title"/>
               <body>Title of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFCore.ModelIdentification-title-lowerValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-title-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFCore.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>title</name>
            <defaultValue xmi:id="CDIFCore.ModelIdentification-title-defaultValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-title-defaultValue" xmi:type="uml:LiteralString">
               <value>UML Model for the CDIF Core Profile</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFCore.ModelIdentification-language" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-language" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFCore.ModelIdentification-language-ownedComment" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-language-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFCore.ModelIdentification-language"/>
               <body>Primary language of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFCore.ModelIdentification-language-lowerValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-language-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFCore.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>language</name>
            <defaultValue xmi:id="CDIFCore.ModelIdentification-language-defaultValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-language-defaultValue" xmi:type="uml:LiteralString">
               <value>en</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFCore.ModelIdentification-uri" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-uri" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFCore.ModelIdentification-uri-ownedComment" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-uri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFCore.ModelIdentification-uri"/>
               <body>Namespace URI of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFCore.ModelIdentification-uri-lowerValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-uri-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFCore.ModelIdentification-uri-upperValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#ModelIdentification-uri-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
