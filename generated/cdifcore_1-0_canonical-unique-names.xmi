                     <annotatedElement xmi:idref="CDIFCore.AdditionalProperty-propertyId"/>
                     <body>schema:propertyID - identifier of the property being asserted (e.g. 'horsepower', 'serialNumber'). Either a literal string or a URI from a known vocabulary.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFCore.AdditionalProperty-propertyId-lowerValue" xmi:uuid="https://w3id.org/cdif/core/1.0/xmi/#AdditionalProperty-propertyId-lowerValue" xmi:type="uml:LiteralInteger">
