         <ownedComment xmi:id="CDIFCodelist.CDIFCodelistPackage-ownedComment" xmi:uuid="https://w3id.org/cdif/codelist/1.1/xmi/#CDIFCodelist-package-ownedComment" xmi:type="uml:Comment">
