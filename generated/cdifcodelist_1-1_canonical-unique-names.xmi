                  </ownedComment>
                  <lowerValue xmi:id="CDIFCodelist.ConceptScheme-note-lowerValue" xmi:uuid="https://w3id.org/cdif/codelist/1.1/xmi/#ConceptScheme-note-lowerValue" xmi:type="uml:LiteralInteger">
