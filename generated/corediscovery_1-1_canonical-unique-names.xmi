            <upperValue xmi:id="CoreDiscovery.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.1/composite/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
