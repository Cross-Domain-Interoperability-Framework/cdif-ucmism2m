                  <ownedComment xmi:id="CoreDiscovery.VariableMeasured-measurementTechnique-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.1/composite/xmi/#VariableMeasured-measurementTechnique-ownedComment" xmi:type="uml:Comment">
