                  <upperValue xmi:id="CoreDiscovery.AdditionalProperty-propertyID-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.1/composite/xmi/#AdditionalProperty-propertyID-upperValue" xmi:type="uml:LiteralInteger">
