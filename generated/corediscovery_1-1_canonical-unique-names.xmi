<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CoreDiscovery.CoreDiscovery" xmi:uuid="https://w3id.org/cdif/discovery/1.1/composite/xmi/#CoreDiscovery">
      <ownedComment xmi:id="CoreDiscovery.CoreDiscovery-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.1/composite/xmi/#CoreDiscovery-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CoreDiscovery.CoreDiscovery"/>
         <body>CoreDiscovery is the smallest CDIF composite profile that produces a discovery-ready dataset metadata record. Assembled from two building-block profile modules: cdifCore (the foundational schema:Dataset shape - identifiers, distribution, agents, license, ...) and cdifDiscovery (measurementTechnique, variableMeasured, spatialCoverage, temporalCoverage, hasQualityMeasurement). A metadata record validating against this composite must declare conformance to https://w3id.org/cdif/core/1.1 and https://w3id.org/cdif/discovery/1.1.</body>
      </ownedComment>
      <name>CoreDiscovery</name>
      <URI>https://w3id.org/cdif/discovery/1.1/composite/xmi/</URI>
      <packagedElement xmi:id="CoreDiscovery.ModelIdentification" xmi:uuid="https://w3id.org/cdif/discovery/1.1/composite/xmi/#ModelIdentification" xmi:type="uml:DataType">
