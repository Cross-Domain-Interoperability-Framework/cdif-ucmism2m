            <ownedComment xmi:id="CoreDiscovery.ModelIdentification-uri-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.1/composite/xmi/#ModelIdentification-uri-ownedComment" xmi:type="uml:Comment">
