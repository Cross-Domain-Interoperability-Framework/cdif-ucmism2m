                     <value>*</value>
                  </upperValue>
                  <name>distribution</name>
                  <type xmi:idref="CoreDiscovery.AbstractDistribution"/>
                  <association xmi:idref="CoreDiscovery.Dataset_distribution_AbstractDistribution"/>
               </ownedAttribute>
