                  <lowerValue xmi:id="CoreDiscovery.AdditionalProperty-name-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.1/composite/xmi/#AdditionalProperty-name-lowerValue" xmi:type="uml:LiteralInteger">
