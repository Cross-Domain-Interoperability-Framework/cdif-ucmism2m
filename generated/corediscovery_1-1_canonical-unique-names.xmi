                     <annotatedElement xmi:idref="CoreDiscovery.AdditionalProperty-propertyID"/>
                     <body>schema:propertyID - identifier of the property being asserted (e.g. 'horsepower', 'serialNumber'). Either a literal string or a URI from a known vocabulary.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CoreDiscovery.AdditionalProperty-propertyID-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.1/composite/xmi/#AdditionalProperty-propertyID-lowerValue" xmi:type="uml:LiteralInteger">
