                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CoreDiscovery.Dataset-measurementTechnique-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.1/composite/xmi/#Dataset-measurementTechnique-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>measurementTechnique</name>
                  <type xmi:idref="CoreDiscovery.DefinedTerm"/>
                  <association xmi:idref="CoreDiscovery.Dataset_measurementTechnique_DefinedTerm"/>
