                     <value>1</value>
                  </upperValue>
                  <name>maintainer</name>
                  <type xmi:idref="CoreDiscovery.Agent"/>
                  <association xmi:idref="CoreDiscovery.CatalogRecord_maintainer_Agent"/>
               </ownedAttribute>
