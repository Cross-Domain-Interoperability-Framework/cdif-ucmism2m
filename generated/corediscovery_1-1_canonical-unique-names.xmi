            <lowerValue xmi:id="CoreDiscovery.ModelIdentification-language-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.1/composite/xmi/#ModelIdentification-language-lowerValue" xmi:type="uml:LiteralInteger">
