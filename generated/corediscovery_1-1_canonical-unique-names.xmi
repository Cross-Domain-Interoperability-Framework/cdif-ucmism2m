            <annotatedElement xmi:idref="CoreDiscovery.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="CoreDiscovery.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/discovery/1.1/composite/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
