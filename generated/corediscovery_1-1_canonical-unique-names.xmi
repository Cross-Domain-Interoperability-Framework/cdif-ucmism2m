               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CoreDiscovery.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.1/composite/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
