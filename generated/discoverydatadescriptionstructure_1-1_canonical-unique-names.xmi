         <ownedAttribute xmi:id="DiscoveryDataDescriptionStructure.ModelIdentification-title" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ModelIdentification-title" xmi:type="uml:Property">
            <ownedComment xmi:id="DiscoveryDataDescriptionStructure.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
