                  <ownedComment xmi:id="DiscoveryDataDescriptionStructure.RepresentedVariable-descriptiveText-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#RepresentedVariable-descriptiveText-ownedComment" xmi:type="uml:Comment">
