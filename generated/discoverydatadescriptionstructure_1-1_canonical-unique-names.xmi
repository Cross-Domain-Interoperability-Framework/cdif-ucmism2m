               <ownedAttribute xmi:id="DiscoveryDataDescriptionStructure.CdifConceptOrTerm-identifier" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#CdifConceptOrTerm-identifier" xmi:type="uml:Property">
