                  <lowerValue xmi:id="DiscoveryDataDescriptionStructure.PhysicalMapping-index-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#PhysicalMapping-index-lowerValue" xmi:type="uml:LiteralInteger">
