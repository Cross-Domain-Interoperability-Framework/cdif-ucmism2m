               <ownedAttribute xmi:id="DiscoveryDataDescriptionStructure.ForeignKey-references" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ForeignKey-references" xmi:type="uml:Property">
