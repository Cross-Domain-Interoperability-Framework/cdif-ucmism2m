            <ownedComment xmi:id="DiscoveryDataDescriptionStructure.ModelIdentification-minorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ModelIdentification-minorVersion-ownedComment" xmi:type="uml:Comment">
