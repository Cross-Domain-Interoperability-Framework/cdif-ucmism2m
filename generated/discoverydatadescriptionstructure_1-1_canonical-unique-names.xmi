                  <ownedComment xmi:id="DiscoveryDataDescriptionStructure.RepresentedVariable-definition-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#RepresentedVariable-definition-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="DiscoveryDataDescriptionStructure.RepresentedVariable-definition"/>
                     <body>Natural language statement conveying the meaning of a concept, differentiating it from other concepts. Supports the use of multiple languages and structured text. 'externalDefinition' can't be used if 'definition' is used.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DiscoveryDataDescriptionStructure.RepresentedVariable-definition-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#RepresentedVariable-definition-lowerValue" xmi:type="uml:LiteralInteger">
