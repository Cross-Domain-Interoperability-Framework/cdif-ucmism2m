<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="DiscoveryDataDescriptionStructure.DiscoveryDataDescriptionStructure" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#DiscoveryDataDescriptionStructure">
      <ownedComment xmi:id="DiscoveryDataDescriptionStructure.DiscoveryDataDescriptionStructure-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#DiscoveryDataDescriptionStructure-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="DiscoveryDataDescriptionStructure.DiscoveryDataDescriptionStructure"/>
         <body>DiscoveryDataDescriptionStructure is the CDIF composite profile that extends DiscoveryDataDescription with full DDI-CDI structural complexity. Assembled from four building-block profile modules: cdifCore + cdifDiscovery + cdifDataDescription + cdifDataStructure. A metadata record validating against this composite must declare conformance to https://w3id.org/cdif/core/1.1, https://w3id.org/cdif/discovery/1.1, https://w3id.org/cdif/data_description/1.1, and https://w3id.org/cdif/data_structure/1.1.</body>
      </ownedComment>
      <name>DiscoveryDataDescriptionStructure</name>
      <URI>https://w3id.org/cdif/data_structure/1.1/composite/xmi/</URI>
      <packagedElement xmi:id="DiscoveryDataDescriptionStructure.ModelIdentification" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ModelIdentification" xmi:type="uml:DataType">
