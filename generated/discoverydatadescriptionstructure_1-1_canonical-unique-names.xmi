               <ownedAttribute xmi:id="DiscoveryDataDescriptionStructure.ForeignKey-isComposedOf" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ForeignKey-isComposedOf" xmi:type="uml:Property">
                  <ownedComment xmi:id="DiscoveryDataDescriptionStructure.ForeignKey-isComposedOf-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ForeignKey-isComposedOf-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="DiscoveryDataDescriptionStructure.ForeignKey-isComposedOf"/>
                     <body>cdi:isComposedOf - the RepresentedVariables in this structure that make up the foreign key.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DiscoveryDataDescriptionStructure.ForeignKey-isComposedOf-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ForeignKey-isComposedOf-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="DiscoveryDataDescriptionStructure.ForeignKey-isComposedOf-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ForeignKey-isComposedOf-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>isComposedOf</name>
                  <type xmi:idref="DiscoveryDataDescriptionStructure.RepresentedVariable"/>
                  <association xmi:idref="DiscoveryDataDescriptionStructure.ForeignKey_isComposedOf_RepresentedVariable"/>
