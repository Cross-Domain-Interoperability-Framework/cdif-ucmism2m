                  <ownedComment xmi:id="DiscoveryDataDescriptionStructure.WebAPI-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#WebAPI-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="DiscoveryDataDescriptionStructure.WebAPI-identifier"/>
                     <body>Documentation
