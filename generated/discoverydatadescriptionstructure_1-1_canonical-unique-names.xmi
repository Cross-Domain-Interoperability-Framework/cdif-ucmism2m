                  <ownedComment xmi:id="DiscoveryDataDescriptionStructure.PhysicalMapping-index-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#PhysicalMapping-index-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="DiscoveryDataDescriptionStructure.PhysicalMapping-index"/>
                     <body>Documentation
