                     <body>@id - resolvable URI of the concept or term being referenced.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DiscoveryDataDescriptionStructure.CdifConceptOrTerm-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#CdifConceptOrTerm-identifier-lowerValue" xmi:type="uml:LiteralInteger">
