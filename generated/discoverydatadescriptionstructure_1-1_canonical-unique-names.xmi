                  <ownedComment xmi:id="DiscoveryDataDescriptionStructure.TabularTextDataSet-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#TabularTextDataSet-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="DiscoveryDataDescriptionStructure.TabularTextDataSet-identifier"/>
                     <body>Documentation
