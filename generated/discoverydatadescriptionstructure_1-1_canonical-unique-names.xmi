               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="DiscoveryDataDescriptionStructure.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
