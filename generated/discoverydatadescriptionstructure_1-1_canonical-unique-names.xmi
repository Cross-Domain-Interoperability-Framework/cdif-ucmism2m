            <annotatedElement xmi:idref="DiscoveryDataDescriptionStructure.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="DiscoveryDataDescriptionStructure.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
