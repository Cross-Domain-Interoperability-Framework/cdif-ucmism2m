                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="DiscoveryDataDescriptionStructure.TabularTextDataSet-tableDirection-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#TabularTextDataSet-tableDirection-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>tableDirection</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
