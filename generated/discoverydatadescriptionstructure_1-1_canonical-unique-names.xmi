                  <ownedComment xmi:id="DiscoveryDataDescriptionStructure.VariableMeasured-measurementTechnique-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#VariableMeasured-measurementTechnique-ownedComment" xmi:type="uml:Comment">
