               <ownedAttribute xmi:id="DiscoveryDataDescriptionStructure.RepresentedVariable-describedUnitOfMeasure" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#RepresentedVariable-describedUnitOfMeasure" xmi:type="uml:Property">
                  <ownedComment xmi:id="DiscoveryDataDescriptionStructure.RepresentedVariable-describedUnitOfMeasure-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#RepresentedVariable-describedUnitOfMeasure-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="DiscoveryDataDescriptionStructure.RepresentedVariable-describedUnitOfMeasure"/>
                     <body>The unit in which the data values are measured (kg, pound, euro), expressed as a value from a controlled system of entries (i.e., QDT). Supports the provision of an identifier for the entry in the authoritative source (a URI, etc.), and the specific vocabulary.</body>
                  </ownedComment>
                  <lowerValue xmi:id="DiscoveryDataDescriptionStructure.RepresentedVariable-describedUnitOfMeasure-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#RepresentedVariable-describedUnitOfMeasure-lowerValue" xmi:type="uml:LiteralInteger">
