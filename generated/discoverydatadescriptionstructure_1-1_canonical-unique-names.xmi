                  <type xmi:idref="DiscoveryDataDescriptionStructure.TemporalExtent"/>
                  <association xmi:idref="DiscoveryDataDescriptionStructure.Dataset_temporalCoverage_TemporalExtent"/>
               </ownedAttribute>
