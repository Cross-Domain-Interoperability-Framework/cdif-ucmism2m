                  <upperValue xmi:id="DiscoveryDataDescriptionStructure.ForeignKey-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ForeignKey-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
