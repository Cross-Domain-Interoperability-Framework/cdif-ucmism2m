            <packagedElement xmi:id="DiscoveryDataDescriptionStructure.AbstractMapping" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#AbstractMapping" xmi:type="uml:Class" isAbstract="true">
