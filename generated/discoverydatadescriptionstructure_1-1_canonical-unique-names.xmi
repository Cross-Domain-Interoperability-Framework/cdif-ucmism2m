                     <value>1</value>
                  </upperValue>
                  <name>maintainer</name>
                  <type xmi:idref="DiscoveryDataDescriptionStructure.Agent"/>
                  <association xmi:idref="DiscoveryDataDescriptionStructure.CatalogRecord_maintainer_Agent"/>
               </ownedAttribute>
