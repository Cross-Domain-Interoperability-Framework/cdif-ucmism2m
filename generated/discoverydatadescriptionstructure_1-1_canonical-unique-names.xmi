                  <lowerValue xmi:id="DiscoveryDataDescriptionStructure.ForeignKey-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ForeignKey-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
