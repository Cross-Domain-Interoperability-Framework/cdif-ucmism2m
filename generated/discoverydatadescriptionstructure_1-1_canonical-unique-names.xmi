                     <value>*</value>
                  </upperValue>
                  <name>distribution</name>
                  <type xmi:idref="DiscoveryDataDescriptionStructure.DataDownload"/>
                  <association xmi:idref="DiscoveryDataDescriptionStructure.Dataset_distribution_DataDownload"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="DiscoveryDataDescriptionStructure.Dataset-distribution-WebAPI" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#Dataset-distribution-WebAPI" xmi:type="uml:Property" aggregation="composite">
