               <ownedComment xmi:id="DiscoveryDataDescriptionStructure.SentinelValueDomain-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#SentinelValueDomain-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="DiscoveryDataDescriptionStructure.SentinelValueDomain"/>
