            <upperValue xmi:id="DiscoveryDataDescriptionStructure.ModelIdentification-minorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ModelIdentification-minorVersion-upperValue" xmi:type="uml:LiteralInteger">
