                  <ownedComment xmi:id="DiscoveryDataDescriptionStructure.AbstractMapping-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#AbstractMapping-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="DiscoveryDataDescriptionStructure.AbstractMapping-identifier"/>
                     <body>Documentation
