                     <value>*</value>
                  </upperValue>
                  <name>distribution</name>
                  <type xmi:idref="DiscoveryDataDescriptionStructure.AbstractDistribution"/>
                  <association xmi:idref="DiscoveryDataDescriptionStructure.Dataset_distribution_AbstractDistribution"/>
               </ownedAttribute>
