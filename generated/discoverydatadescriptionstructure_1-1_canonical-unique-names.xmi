                     <value>*</value>
                  </upperValue>
                  <name>measurementTechnique</name>
                  <type xmi:idref="DiscoveryDataDescriptionStructure.DefinedTerm"/>
                  <association xmi:idref="DiscoveryDataDescriptionStructure.InstanceVariable_measurementTechnique_DefinedTerm"/>
