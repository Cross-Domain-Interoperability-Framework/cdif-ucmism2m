               <ownedComment xmi:id="DiscoveryDataDescriptionStructure.ValueAndConceptDescription-ownedComment" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#ValueAndConceptDescription-ownedComment" xmi:type="uml:Comment">
