                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="DiscoveryDataDescriptionStructure.DimensionGroup-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/data_structure/1.1/composite/xmi/#DimensionGroup-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="DiscoveryDataDescriptionStructure.XsdAnyUri"/>
               </ownedAttribute>
