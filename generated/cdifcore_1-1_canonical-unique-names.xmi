                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFCore.DefinedTerm-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/core/1.1/xmi/#DefinedTerm-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFCore.Identifier"/>
               </ownedAttribute>
