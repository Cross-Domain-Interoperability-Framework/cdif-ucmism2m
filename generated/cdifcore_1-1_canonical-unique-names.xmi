schema:description - short summary describing the resource.
</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFCore.Dataset-description-lowerValue" xmi:uuid="https://w3id.org/cdif/core/1.1/xmi/#Dataset-description-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFCore.Dataset-description-upperValue" xmi:uuid="https://w3id.org/cdif/core/1.1/xmi/#Dataset-description-upperValue" xmi:type="uml:LiteralInteger">
