                     <value>1</value>
                  </upperValue>
                  <name>propertyID</name>
                  <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFCore.Identifier-value" xmi:uuid="https://w3id.org/cdif/core/1.1/xmi/#Identifier-value" xmi:type="uml:Property">
