                  <ownedComment xmi:id="BasicDiscovery.Dataset-measurementTechnique-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-measurementTechnique-ownedComment" xmi:type="uml:Comment">
