            <upperValue xmi:id="BasicDiscovery.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
