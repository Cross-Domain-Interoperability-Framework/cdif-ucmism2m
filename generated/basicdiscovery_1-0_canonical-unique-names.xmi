         <ownedAttribute xmi:id="BasicDiscovery.ModelIdentification-uri" xmi:uuid="https://w3id.org/cdif/discovery/1.0/composite/xmi/#ModelIdentification-uri" xmi:type="uml:Property">
            <ownedComment xmi:id="BasicDiscovery.ModelIdentification-uri-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/composite/xmi/#ModelIdentification-uri-ownedComment" xmi:type="uml:Comment">
