            <ownedComment xmi:id="BasicDiscovery.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/composite/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
