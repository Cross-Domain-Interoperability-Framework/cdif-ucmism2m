                  <upperValue xmi:id="BasicDiscovery.Dataset-additionalType-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-additionalType-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
