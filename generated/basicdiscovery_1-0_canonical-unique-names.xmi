         <ownedAttribute xmi:id="BasicDiscovery.ModelIdentification-language" xmi:uuid="https://w3id.org/cdif/discovery/1.0/composite/xmi/#ModelIdentification-language" xmi:type="uml:Property">
            <ownedComment xmi:id="BasicDiscovery.ModelIdentification-language-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/composite/xmi/#ModelIdentification-language-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="BasicDiscovery.ModelIdentification-language"/>
               <body>Primary language of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="BasicDiscovery.ModelIdentification-language-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/composite/xmi/#ModelIdentification-language-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="BasicDiscovery.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/composite/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>language</name>
