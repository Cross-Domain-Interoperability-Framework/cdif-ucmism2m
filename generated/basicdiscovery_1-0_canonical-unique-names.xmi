               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="BasicDiscovery.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/composite/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
