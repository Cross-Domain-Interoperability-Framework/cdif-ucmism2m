            <lowerValue xmi:id="BasicDiscovery.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/composite/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="BasicDiscovery.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/composite/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>prefix</name>
            <defaultValue xmi:id="BasicDiscovery.ModelIdentification-prefix-defaultValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/composite/xmi/#ModelIdentification-prefix-defaultValue" xmi:type="uml:LiteralString">
