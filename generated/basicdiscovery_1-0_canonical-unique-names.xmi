   <uml:Model xmi:id="BasicDiscovery.BasicDiscovery" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#BasicDiscovery">
      <ownedComment xmi:id="BasicDiscovery.BasicDiscovery-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#BasicDiscovery-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="BasicDiscovery.BasicDiscovery"/>
         <body>CDIF Discovery profile - extends CDIF Core with discovery-oriented properties: measurement technique, variables measured, spatial and temporal coverage, quality measurements. Conforms-to identifier: https://w3id.org/cdif/discovery/1.0.</body>
      </ownedComment>
      <name>BasicDiscovery</name>
      <URI>https://w3id.org/cdif/discovery/1.0/xmi/</URI>
      <packagedElement xmi:id="BasicDiscovery.ModelIdentification" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification" xmi:type="uml:DataType">
