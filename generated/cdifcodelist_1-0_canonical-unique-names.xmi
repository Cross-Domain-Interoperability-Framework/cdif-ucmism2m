<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CDIFCodelist.CDIFCodelist" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#CDIFCodelist">
      <ownedComment xmi:id="CDIFCodelist.CDIFCodelist-ownedComment" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#CDIFCodelist-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFCodelist.CDIFCodelist"/>
         <body>CDIF profile for controlled-vocabulary codelists implemented as SKOS ConceptSchemes. Each concept must have a resolvable @id, skos:inScheme, skos:definition and skos:prefLabel. The scheme must declare skos:hasTopConcept; concepts in a hierarchy must declare both skos:narrower (downward) and skos:broader (upward). CDIF metadata properties (schema:identifier, schema:dateModified, schema:license or schema:conditionsOfAccess) take precedence over the equivalent dcterms properties from the base skosConceptScheme building block. Required attributes per the profile JSON schema and rules.shacl: ConceptScheme @id, schema:identifier, schema:dateModified, skos:hasTopConcept, plus (license OR conditionsOfAccess); Concept @id, skos:inScheme, skos:definition, skos:prefLabel, skos:notation.</body>
      </ownedComment>
      <name>CDIFCodelist</name>
      <URI>https://w3id.org/cdif/codelist/1.0/xmi/</URI>
      <packagedElement xmi:id="CDIFCodelist.ModelIdentification" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification" xmi:type="uml:DataType">
         <ownedComment xmi:id="CDIFCodelist.ModelIdentification-ownedComment" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFCodelist.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="CDIFCodelist.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFCodelist.ModelIdentification-prefix-ownedComment" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-prefix-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFCodelist.ModelIdentification-prefix"/>
               <body>Namespace prefix of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFCodelist.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFCodelist.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>prefix</name>
            <defaultValue xmi:id="CDIFCodelist.ModelIdentification-prefix-defaultValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-prefix-defaultValue" xmi:type="uml:LiteralString">
               <value>cdif</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFCodelist.ModelIdentification-majorVersion" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-majorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFCodelist.ModelIdentification-majorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-majorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFCodelist.ModelIdentification-majorVersion"/>
               <body>Major version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFCodelist.ModelIdentification-majorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-majorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFCodelist.ModelIdentification-majorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-majorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>majorVersion</name>
            <defaultValue xmi:id="CDIFCodelist.ModelIdentification-majorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-majorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFCodelist.ModelIdentification-minorVersion" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-minorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFCodelist.ModelIdentification-minorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-minorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFCodelist.ModelIdentification-minorVersion"/>
               <body>Minor version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFCodelist.ModelIdentification-minorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-minorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFCodelist.ModelIdentification-minorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-minorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>minorVersion</name>
            <defaultValue xmi:id="CDIFCodelist.ModelIdentification-minorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-minorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>0</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFCodelist.ModelIdentification-title" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-title" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFCodelist.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFCodelist.ModelIdentification-title"/>
               <body>Title of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFCodelist.ModelIdentification-title-lowerValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-title-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFCodelist.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>title</name>
            <defaultValue xmi:id="CDIFCodelist.ModelIdentification-title-defaultValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-title-defaultValue" xmi:type="uml:LiteralString">
               <value>UML Model for the CDIF Codelist Profile</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFCodelist.ModelIdentification-language" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-language" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFCodelist.ModelIdentification-language-ownedComment" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-language-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFCodelist.ModelIdentification-language"/>
               <body>Primary language of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFCodelist.ModelIdentification-language-lowerValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-language-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFCodelist.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>language</name>
            <defaultValue xmi:id="CDIFCodelist.ModelIdentification-language-defaultValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-language-defaultValue" xmi:type="uml:LiteralString">
               <value>en</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFCodelist.ModelIdentification-uri" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-uri" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFCodelist.ModelIdentification-uri-ownedComment" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-uri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFCodelist.ModelIdentification-uri"/>
               <body>Namespace URI of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFCodelist.ModelIdentification-uri-lowerValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-uri-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFCodelist.ModelIdentification-uri-upperValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-uri-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>uri</name>
            <defaultValue xmi:id="CDIFCodelist.ModelIdentification-uri-defaultValue" xmi:uuid="https://w3id.org/cdif/codelist/1.0/xmi/#ModelIdentification-uri-defaultValue" xmi:type="uml:LiteralString">
