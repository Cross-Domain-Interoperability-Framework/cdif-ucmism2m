<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xmi:XMI xmlns:StandardProfile="http://www.eclipse.org/uml2/5.0.0/UML/Profile/Standard" xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
   <uml:Model xmi:id="CDIFDiscovery.CDIFDiscovery" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#CDIFDiscovery">
      <ownedComment xmi:id="CDIFDiscovery.CDIFDiscovery-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#CDIFDiscovery-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFDiscovery.CDIFDiscovery"/>
         <body>CDIF Discovery profile module - the discovery-oriented extension properties added on top of a cdifCore Dataset: schema:measurementTechnique (string or DefinedTerm), schema:variableMeasured (VariableMeasured / PropertyValue), schema:spatialCoverage (SpatialExtent / Place), schema:temporalCoverage (TemporalExtent), dqv:hasQualityMeasurement (QualityMeasure). The catalog record (schema:subjectOf &gt; CatalogRecord) MUST declare conformance to https://w3id.org/cdif/discovery/1.0.</body>
      </ownedComment>
      <name>CDIFDiscovery</name>
      <URI>https://w3id.org/cdif/discovery/1.0/xmi/</URI>
      <packagedElement xmi:id="CDIFDiscovery.ModelIdentification" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification" xmi:type="uml:DataType">
         <ownedComment xmi:id="CDIFDiscovery.ModelIdentification-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFDiscovery.ModelIdentification"/>
            <body>Identification metadata for this profile model: constant, read-only attributes carrying the model's prefix, version, title, language and URI.</body>
         </ownedComment>
         <name>ModelIdentification</name>
         <ownedAttribute xmi:id="CDIFDiscovery.ModelIdentification-prefix" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-prefix" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDiscovery.ModelIdentification-prefix-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-prefix-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDiscovery.ModelIdentification-prefix"/>
               <body>Namespace prefix of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDiscovery.ModelIdentification-prefix-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-prefix-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDiscovery.ModelIdentification-prefix-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-prefix-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>prefix</name>
            <defaultValue xmi:id="CDIFDiscovery.ModelIdentification-prefix-defaultValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-prefix-defaultValue" xmi:type="uml:LiteralString">
               <value>cdif</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDiscovery.ModelIdentification-majorVersion" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-majorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDiscovery.ModelIdentification-majorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-majorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDiscovery.ModelIdentification-majorVersion"/>
               <body>Major version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDiscovery.ModelIdentification-majorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-majorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDiscovery.ModelIdentification-majorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-majorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>majorVersion</name>
            <defaultValue xmi:id="CDIFDiscovery.ModelIdentification-majorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-majorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDiscovery.ModelIdentification-minorVersion" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-minorVersion" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDiscovery.ModelIdentification-minorVersion-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-minorVersion-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDiscovery.ModelIdentification-minorVersion"/>
               <body>Minor version number of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDiscovery.ModelIdentification-minorVersion-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-minorVersion-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDiscovery.ModelIdentification-minorVersion-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-minorVersion-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>minorVersion</name>
            <defaultValue xmi:id="CDIFDiscovery.ModelIdentification-minorVersion-defaultValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-minorVersion-defaultValue" xmi:type="uml:LiteralInteger">
               <value>0</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#Integer"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDiscovery.ModelIdentification-title" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-title" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDiscovery.ModelIdentification-title-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-title-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDiscovery.ModelIdentification-title"/>
               <body>Title of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDiscovery.ModelIdentification-title-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-title-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDiscovery.ModelIdentification-title-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-title-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>title</name>
            <defaultValue xmi:id="CDIFDiscovery.ModelIdentification-title-defaultValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-title-defaultValue" xmi:type="uml:LiteralString">
               <value>UML Model for the CDIF Discovery Profile</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDiscovery.ModelIdentification-language" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-language" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDiscovery.ModelIdentification-language-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-language-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDiscovery.ModelIdentification-language"/>
               <body>Primary language of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDiscovery.ModelIdentification-language-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-language-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDiscovery.ModelIdentification-language-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-language-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>language</name>
            <defaultValue xmi:id="CDIFDiscovery.ModelIdentification-language-defaultValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-language-defaultValue" xmi:type="uml:LiteralString">
               <value>en</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
         <ownedAttribute xmi:id="CDIFDiscovery.ModelIdentification-uri" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-uri" xmi:type="uml:Property">
            <ownedComment xmi:id="CDIFDiscovery.ModelIdentification-uri-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-uri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDiscovery.ModelIdentification-uri"/>
               <body>Namespace URI of the model.</body>
            </ownedComment>
            <lowerValue xmi:id="CDIFDiscovery.ModelIdentification-uri-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-uri-lowerValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </lowerValue>
            <upperValue xmi:id="CDIFDiscovery.ModelIdentification-uri-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-uri-upperValue" xmi:type="uml:LiteralInteger">
               <value>1</value>
            </upperValue>
            <name>uri</name>
            <defaultValue xmi:id="CDIFDiscovery.ModelIdentification-uri-defaultValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification-uri-defaultValue" xmi:type="uml:LiteralString">
               <value>https://w3id.org/cdif/discovery/1.0/xmi/</value>
            </defaultValue>
            <isReadOnly>true</isReadOnly>
            <type xmi:type="uml:PrimitiveType" href="http://www.eclipse.org/uml2/5.0.0/UML/PrimitiveTypes.xmi#String"/>
         </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:id="CDIFDiscovery.CDIFDiscoveryPackage" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#CDIFDiscovery-package" xmi:type="uml:Package">
         <ownedComment xmi:id="CDIFDiscovery.CDIFDiscoveryPackage-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#CDIFDiscovery-package-ownedComment" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="CDIFDiscovery.CDIFDiscoveryPackage"/>
            <body>Discovery extension properties for a CDIF Dataset.</body>
         </ownedComment>
         <name>CDIFDiscovery</name>
         <packagedElement xmi:id="CDIFDiscovery.XsdAnyUri" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#XsdAnyUri" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFDiscovery.XsdAnyUri-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#XsdAnyUri-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDiscovery.XsdAnyUri"/>
               <body>Primitive data type "anyURI" of the XML Schema data types.

Definition from XML Schema Part 2: Datatypes Second Edition: "anyURI" represents a Uniform Resource Identifier Reference (URI). An "anyURI" value can be absolute or relative, and may have an optional fragment identifier (i.e., it may be a URI Reference). This type should be used to specify the intention that the value fulfills the role of a URI as defined by [RFC 2396], as amended by [RFC 2732]. For details see https://www.w3.org/TR/xmlschema-2/#anyURI.</body>
            </ownedComment>
            <name>XsdAnyUri</name>
         </packagedElement>
         <packagedElement xmi:id="CDIFDiscovery.XsdDate" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#XsdDate" xmi:type="uml:DataType">
            <ownedComment xmi:id="CDIFDiscovery.XsdDate-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#XsdDate-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDiscovery.XsdDate"/>
               <body>Primitive data type "date" of the XML Schema data types.

Definition from XML Schema Part 2: Datatypes Second Edition: "The value space of date consists of top-open intervals of exactly one day in length on the timelines of dateTime, beginning on the beginning moment of each day (in each timezone), i.e. '00:00:00', up to but not including '24:00:00' (which is identical with '00:00:00' of the next day). For nontimezoned values, the top-open intervals disjointly cover the nontimezoned timeline, one per day. For timezoned values, the intervals begin at every minute and therefore overlap." For details see https://www.w3.org/TR/xmlschema-2/#date.</body>
            </ownedComment>
            <name>XsdDate</name>
         </packagedElement>
         <packagedElement xmi:id="CDIFDiscovery.Classes" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Classes-package" xmi:type="uml:Package">
            <ownedComment xmi:id="CDIFDiscovery.Classes-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Classes-package-ownedComment" xmi:type="uml:Comment">
               <annotatedElement xmi:idref="CDIFDiscovery.Classes"/>
               <body>Target classes of the CDIF profile.</body>
            </ownedComment>
            <name>Classes</name>
            <packagedElement xmi:id="CDIFDiscovery.Dataset" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset" xmi:type="uml:Class">
               <ownedComment xmi:id="CDIFDiscovery.Dataset-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-ownedComment" xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="CDIFDiscovery.Dataset"/>
                  <body>Stub of schema:Dataset (full definition in CDIFCore). The discovery profile adds measurementTechnique / variableMeasured / spatialCoverage / temporalCoverage / hasQualityMeasurement to this Dataset.</body>
               </ownedComment>
               <name>Dataset</name>
               <ownedAttribute xmi:id="CDIFDiscovery.Dataset-identifier" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-identifier" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDiscovery.Dataset-identifier-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-identifier-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDiscovery.Dataset-identifier"/>
                     <body>@id - resolvable URI for the dataset.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDiscovery.Dataset-identifier-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-identifier-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDiscovery.Dataset-identifier-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-identifier-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>identifier</name>
                  <type xmi:idref="CDIFDiscovery.XsdAnyUri"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDiscovery.Dataset-subjectOf" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-subjectOf" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFDiscovery.Dataset-subjectOf-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-subjectOf-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDiscovery.Dataset-subjectOf"/>
                     <body>schema:subjectOf - the catalog record describing this dataset's metadata. For the discovery profile, the CatalogRecord MUST declare conformance to https://w3id.org/cdif/discovery/1.0.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDiscovery.Dataset-subjectOf-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-subjectOf-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDiscovery.Dataset-subjectOf-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-subjectOf-upperValue" xmi:type="uml:LiteralInteger">
                     <value>1</value>
                  </upperValue>
                  <name>subjectOf</name>
                  <type xmi:idref="CDIFDiscovery.CatalogRecord"/>
                  <association xmi:idref="CDIFDiscovery.Dataset_subjectOf_CatalogRecord"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDiscovery.Dataset-measurementTechnique" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-measurementTechnique" xmi:type="uml:Property">
                  <ownedComment xmi:id="CDIFDiscovery.Dataset-measurementTechnique-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-measurementTechnique-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDiscovery.Dataset-measurementTechnique"/>
                     <body>schema:measurementTechnique - technique / technology / methodology used. May be a plain string or a DefinedTerm reference (this edge models the DefinedTerm branch).</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDiscovery.Dataset-measurementTechnique-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-measurementTechnique-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDiscovery.Dataset-measurementTechnique-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-measurementTechnique-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>measurementTechnique</name>
                  <type xmi:idref="CDIFDiscovery.DefinedTerm"/>
                  <association xmi:idref="CDIFDiscovery.Dataset_measurementTechnique_DefinedTerm"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDiscovery.Dataset-variableMeasured" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-variableMeasured" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFDiscovery.Dataset-variableMeasured-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-variableMeasured-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDiscovery.Dataset-variableMeasured"/>
                     <body>schema:variableMeasured - the variables described by this dataset.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDiscovery.Dataset-variableMeasured-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-variableMeasured-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDiscovery.Dataset-variableMeasured-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-variableMeasured-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>variableMeasured</name>
                  <type xmi:idref="CDIFDiscovery.VariableMeasured"/>
                  <association xmi:idref="CDIFDiscovery.Dataset_variableMeasured_VariableMeasured"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDiscovery.Dataset-spatialCoverage" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-spatialCoverage" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFDiscovery.Dataset-spatialCoverage-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-spatialCoverage-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDiscovery.Dataset-spatialCoverage"/>
                     <body>schema:spatialCoverage - geographic extent of the dataset's content.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDiscovery.Dataset-spatialCoverage-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-spatialCoverage-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDiscovery.Dataset-spatialCoverage-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-spatialCoverage-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>spatialCoverage</name>
                  <type xmi:idref="CDIFDiscovery.SpatialExtent"/>
                  <association xmi:idref="CDIFDiscovery.Dataset_spatialCoverage_SpatialExtent"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDiscovery.Dataset-temporalCoverage" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-temporalCoverage" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFDiscovery.Dataset-temporalCoverage-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-temporalCoverage-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDiscovery.Dataset-temporalCoverage"/>
                     <body>schema:temporalCoverage - period of time the dataset covers.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDiscovery.Dataset-temporalCoverage-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-temporalCoverage-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDiscovery.Dataset-temporalCoverage-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-temporalCoverage-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>temporalCoverage</name>
                  <type xmi:idref="CDIFDiscovery.TemporalExtent"/>
                  <association xmi:idref="CDIFDiscovery.Dataset_temporalCoverage_TemporalExtent"/>
               </ownedAttribute>
               <ownedAttribute xmi:id="CDIFDiscovery.Dataset-hasQualityMeasurement" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-hasQualityMeasurement" xmi:type="uml:Property" aggregation="composite">
                  <ownedComment xmi:id="CDIFDiscovery.Dataset-hasQualityMeasurement-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-hasQualityMeasurement-ownedComment" xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="CDIFDiscovery.Dataset-hasQualityMeasurement"/>
                     <body>dqv:hasQualityMeasurement - quality measurements reported about the dataset.</body>
                  </ownedComment>
                  <lowerValue xmi:id="CDIFDiscovery.Dataset-hasQualityMeasurement-lowerValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-hasQualityMeasurement-lowerValue" xmi:type="uml:LiteralInteger">
                     <value>0</value>
                  </lowerValue>
                  <upperValue xmi:id="CDIFDiscovery.Dataset-hasQualityMeasurement-upperValue" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#Dataset-hasQualityMeasurement-upperValue" xmi:type="uml:LiteralUnlimitedNatural">
                     <value>*</value>
                  </upperValue>
                  <name>hasQualityMeasurement</name>
                  <type xmi:idref="CDIFDiscovery.QualityMeasure"/>
                  <association xmi:idref="CDIFDiscovery.Dataset_hasQualityMeasurement_QualityMeasure"/>
