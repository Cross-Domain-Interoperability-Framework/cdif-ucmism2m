   <uml:Model xmi:id="CDIFDiscovery.CDIFDiscovery" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#CDIFDiscovery">
      <ownedComment xmi:id="CDIFDiscovery.CDIFDiscovery-ownedComment" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#CDIFDiscovery-ownedComment" xmi:type="uml:Comment">
         <annotatedElement xmi:idref="CDIFDiscovery.CDIFDiscovery"/>
         <body>CDIF Discovery profile - extends CDIF Core with discovery-oriented properties: measurement technique, variables measured, spatial and temporal coverage, quality measurements. Conforms-to identifier: https://w3id.org/cdif/discovery/1.0.</body>
      </ownedComment>
      <name>CDIFDiscovery</name>
      <URI>https://w3id.org/cdif/discovery/1.0/xmi/</URI>
      <packagedElement xmi:id="CDIFDiscovery.ModelIdentification" xmi:uuid="https://w3id.org/cdif/discovery/1.0/xmi/#ModelIdentification" xmi:type="uml:DataType">
